[Unit]
Description=agentbox roadmap reconciler (daily; Claude Code premium lane)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{ user }}
Environment=HOME=/home/{{ user }}
# ~/.local/bin is on PATH because uv tools land there: tvly for the
# tavily-search skill, and whatever a skill installs for itself at runtime
# (graphify does its own `uv tool install` on first use).
Environment=PATH={{ home }}/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-{{ home }}/.config/agentbox/agentbox.env
WorkingDirectory={{ home }}
ExecStart=/usr/local/bin/agentbox-roadmap-reconcile.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agentbox-roadmap
