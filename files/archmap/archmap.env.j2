# archmap - environment file, shared by archmap-api and archmap-worker.
# Rendered from files/archmap/archmap.env.j2 with values from the vault's
# top-level `archmap:` group. The postgres password is URL-safe by
# construction (deploy-pattern gotcha 9), so it goes into the URL as-is.

ARCHMAP_DATABASE_URL=postgresql://{{ service }}:{{ archmap.postgres_password }}@postgres:5432/{{ service }}
ARCHMAP_DATA_DIR=/data

# Single-quoted so docker-compose passes them through literally.
ARCHMAP_GITHUB_TOKEN='{{ archmap.github_token }}'
ARCHMAP_MCP_TOKEN='{{ archmap.mcp_token }}'

ARCHMAP_PROMETHEUS_URL=http://192.168.1.143:{{ service_ports.prometheus.port }}
ARCHMAP_POLL_SECONDS={{ archmap.poll_seconds | default(60) }}
