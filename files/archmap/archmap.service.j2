[Unit]
Description=archmap fleet map (api, worker, postgres, tile nginx) (Docker Compose)
Documentation=https://github.com/bluefishforsale/archmap
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service
# harbor's local state disk, never ocean's NFS view of the same path.
RequiresMountsFor=/data01/services

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ home }}

Environment=COMPOSE_PROJECT_NAME={{ service }}
Environment=COMPOSE_HTTP_TIMEOUT=60
Environment=PATH=/usr/local/bin:/usr/bin:/bin

ExecStartPre=/bin/bash -c 'cd {{ home }} && /usr/bin/docker compose down'
# Tolerant (leading '-') so a host reboot during a registry blip still starts
# on the cached image; the deploy-time pull above is the loud guard. Not
# --quiet, so a failed pull is visible in the journal.
ExecStartPre=-/bin/bash -c 'cd {{ home }} && /usr/bin/docker compose pull'

ExecStart=/bin/bash -c 'cd {{ home }} && /usr/bin/docker compose up -d'
ExecStop=/bin/bash -c 'cd {{ home }} && /usr/bin/docker compose down'
ExecReload=/bin/bash -c 'cd {{ home }} && /usr/bin/docker compose restart'

Restart=on-failure
RestartSec=30
TimeoutStartSec=1200
TimeoutStopSec=60

NoNewPrivileges=true
ReadWritePaths={{ home }}
ReadOnlyPaths=/var/run/docker.sock

StandardOutput=journal
StandardError=journal
SyslogIdentifier={{ service }}

[Install]
WantedBy=multi-user.target
