# archmap: one image in two roles (api, worker) beside its own Postgres, and an
# nginx that serves rendered tiles straight off disk so tile fetches never touch
# Python. Only the nginx is published on the host.
services:
  postgres:
    image: postgres:16
    container_name: {{ service }}-postgres
    hostname: {{ service }}-postgres
    restart: unless-stopped
    environment:
      - TZ=America/Los_Angeles
      - POSTGRES_USER={{ service }}
      - POSTGRES_DB={{ service }}
      - POSTGRES_PASSWORD={{ archmap.postgres_password }}
    volumes:
      - {{ home }}/postgres:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ service }} -d {{ service }}"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 20s
    logging:
      driver: journald
      options:
        tag: "{{ service }}-postgres"

  api:
    image: {{ image }}:{{ version }}
    container_name: {{ service }}-api
    hostname: {{ service }}-api
    restart: unless-stopped
    command: ["archmap-api"]
    env_file:
      - {{ home }}/.env
    environment:
      - TZ=America/Los_Angeles
    volumes:
      - {{ home }}/data:/data
    depends_on:
      postgres:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:{{ api_port }}/healthz').read()"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
    logging:
      driver: journald
      options:
        tag: "{{ service }}-api"

  worker:
    image: {{ image }}:{{ version }}
    container_name: {{ service }}-worker
    hostname: {{ service }}-worker
    restart: unless-stopped
    command: ["archmap-worker"]
    # 6 render processes (ARCHMAP_RENDER_PROCS default), the build thread with
    # its multi-threaded SCIP indexers, and polling. ocean's other 22 cores
    # stay with everything else on the host.
    cpus: 8
    # Each render process holds a few snapshots in memory.
    mem_limit: 6g
    env_file:
      - {{ home }}/.env
    environment:
      - TZ=America/Los_Angeles
    volumes:
      - {{ home }}/data:/data
    depends_on:
      postgres:
        condition: service_healthy
    # The worker has no HTTP surface except /metrics, so that is the liveness
    # signal; a stalled queue is the alert's job, not the healthcheck's.
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:{{ worker_metrics_port }}/metrics').read()"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
    logging:
      driver: journald
      options:
        tag: "{{ service }}-worker"

  web:
    image: nginx:stable-alpine
    container_name: {{ service }}-web
    hostname: {{ service }}-web
    restart: unless-stopped
    environment:
      - TZ=America/Los_Angeles
    ports:
      - "0.0.0.0:{{ port_ext }}:80"
    volumes:
      - {{ home }}/nginx-tiles.conf:/etc/nginx/conf.d/default.conf:ro
      - {{ home }}/data/tiles:/srv/tiles:ro
    depends_on:
      - api
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1/nginx-health"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    logging:
      driver: journald
      options:
        tag: "{{ service }}-web"
