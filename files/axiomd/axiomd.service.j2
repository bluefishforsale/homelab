[Unit]
Description=axiomd ops: read-only triage of low-priority alerts (Docker Compose)
Documentation=https://github.com/bluefishforsale/axiomd
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service
# Five crashes in ten minutes leaves the unit failed, which is what SystemdUnitFailed watches.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory={{ home }}
Environment=COMPOSE_PROJECT_NAME={{ service }}
Environment=PATH=/usr/local/bin:/usr/bin:/bin

ExecStartPre=-/bin/bash -c 'cd {{ home }} && /usr/bin/docker compose down'
# Foreground, so the unit lives and dies with the container.
ExecStart=/bin/bash -c 'cd {{ home }} && exec /usr/bin/docker compose up --abort-on-container-exit'
ExecStop=/bin/bash -c 'cd {{ home }} && /usr/bin/docker compose down'

Restart=on-failure
RestartSec=30
TimeoutStopSec=60

NoNewPrivileges=true
ReadWritePaths={{ home }}
ReadOnlyPaths=/var/run/docker.sock

StandardOutput=journal
StandardError=journal
SyslogIdentifier={{ service }}

[Install]
WantedBy=multi-user.target
