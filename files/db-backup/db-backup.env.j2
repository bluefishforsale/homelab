# Rendered by playbooks/operations/backup/db_backup.yaml. Mode 0600. Do not edit on host.
SERVICES_DIR=/data01/services
# A worker's root is squashed over NFS, so it stages on its own state disk.
STAGING={{ '/data01/backups/db-staging' if inventory_hostname == 'ocean' else home + '/staging' }}
TEXTFILE_DIR=/data01/services/node-exporter/text_files
# GCS upload only fires when the SA key file also exists (Phase 1). Until then
# the job runs local-only with a 2-tarball retention.
GCS_BUCKET={{ backup_gcs_bucket }}
GCS_SA_KEY={{ home }}/gcs-sa.json
{% if inventory_hostname == 'ocean' %}
MYSQL_ROOT_PASSWORD={{ databases.mysql.root_password }}
WORDPRESS_DB_CONTAINER=blog_saetnere_com_wp_db
WORDPRESS_ROOT_PASSWORD={{ cloud_services.wordpress.database_root_password }}
{% else %}
# NOTE: workers skip the SQLite set. A host that still holds a moved service's
# old .db would otherwise upload it over the live host's backup.
SKIP_SQLITE=1
{% endif %}
