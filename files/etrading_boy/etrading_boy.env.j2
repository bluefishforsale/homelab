# etrading-boy - environment file
# Rendered from files/etrading_boy/etrading_boy.env.j2 with values from vault/secrets.yaml

# Paper account only. E*TRADE's OAuth needs a browser and a PIN, which a
# headless container can't do, so BROKER stays alpaca here.
BROKER=alpaca
ALPACA_PAPER=true
ALPACA_FEED=sip
ALPACA_API_KEY='{{ financial.alpaca.paper.api_key }}'
ALPACA_API_SECRET='{{ financial.alpaca.paper.api_secret }}'

POLYGON_API_KEY='{{ financial.polygon_io.api_key }}'
FINNHUB_API_KEY='{{ financial.finnhub.api_key }}'

# Only the 17:00 ET daily review uses the LLM. Its own key, never the
# shared ANTHROPIC_API_KEY, so its spend stays separate.
ETRADING_ANTHROPIC_API_KEY='{{ ai_services.claude.etrading_boy.api_key }}'

# The app verifies the Cloudflare Access JWT itself. With either value
# empty it fails closed and only admits loopback, so a missing key shows up
# as a dead feed and 403s on pause, never as an open dashboard.
CF_ACCESS_TEAM_DOMAIN='{{ cloudflare.access.team_domain | default("") }}'
CF_ACCESS_AUD='{{ cloudflare.access.etrading_boy.aud | default("") }}'
ETRADING_WEB_ORIGINS=https://etrading.terrac.com

# The etrading.home vhost injects this as X-Etrading-Lan-Token, which admits
# LAN users without Access. Empty admits nobody.
ETRADING_LAN_TOKEN='{{ etrading_boy.lan_token | default("") }}'
