{
  "uid": "homelab-logs",
  "title": "Homelab Logs",
  "tags": [
    "logs",
    "loki"
  ],
  "description": "Search-first log explorer: filter by host, service, container, level and free text. Pipeline health stays on Homelab Loki & Promtail.",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 40,
  "version": 1,
  "refresh": "",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Loki & Promtail health",
      "type": "link",
      "url": "/d/homelab-loki-promtail",
      "icon": "dashboard"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "P8E80F9AEF21F6940"
        },
        "query": {
          "type": 1,
          "label": "nodename",
          "stream": "",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(nodename)",
        "regex": "",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "unit",
        "label": "Service (systemd)",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "P8E80F9AEF21F6940"
        },
        "query": {
          "type": 1,
          "label": "unit",
          "stream": "{nodename=~\"$host\"}",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values({nodename=~\"$host\"}, unit)",
        "regex": "/.*\\.service$/",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "P8E80F9AEF21F6940"
        },
        "query": {
          "type": 1,
          "label": "container",
          "stream": "{nodename=~\"$host\"}",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values({nodename=~\"$host\"}, container)",
        "regex": "",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "multi": false,
        "includeAll": false,
        "query": "all : .*,errors : (?i)(error|fatal|panic|traceback|failed|exception),warnings : (?i)warn",
        "options": [],
        "current": {
          "selected": true,
          "text": "all",
          "value": ".*"
        }
      },
      {
        "name": "search",
        "label": "Search (regex, case-insensitive)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "exclude",
        "label": "Exclude (regex)",
        "type": "textbox",
        "query": "^__none__$",
        "current": {
          "text": "^__none__$",
          "value": "^__none__$"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Log volume by source",
      "description": "Lines per interval for the current filters, the 15 busiest sources (container, else systemd unit). Click a legend entry to isolate it.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "expr": "topk(15, sum by (source) (label_replace(label_replace(count_over_time({nodename=~\"$host\", unit=~\"$unit\", container=~\"$container\"} |~ \"$level\" |~ \"(?i)$search\" !~ \"(?i)$exclude\" [$__auto]), \"source\", \"$1\", \"unit\", \"(.+)\"), \"source\", \"$1\", \"container\", \"(.+)\")))",
          "refId": "A",
          "queryType": "range",
          "legendFormat": "{{source}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ],
          "sortBy": "Total",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Noisiest sources (time range)",
      "description": "Top 10 streams by line count over the selected range. A service far above the rest is usually a logging bug, not traffic.",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "expr": "topk(10, sum by (nodename, source) (label_replace(label_replace(count_over_time({nodename=~\"$host\", unit=~\"$unit\", container=~\"$container\"} [$__range]), \"source\", \"$1\", \"unit\", \"(.+)\"), \"source\", \"$1\", \"container\", \"(.+)\")))",
          "refId": "A",
          "queryType": "instant",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "nodename": "host",
              "Value #A": "lines"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "lines",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error lines by host",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "expr": "sum by (nodename) (count_over_time({nodename=~\"$host\", unit=~\"$unit\", container=~\"$container\"} |~ \"(?i)(error|fatal|panic|traceback|failed|exception)\" |~ \"(?i)$search\" !~ \"(?i)$exclude\" [$__auto]))",
          "refId": "A",
          "queryType": "range",
          "legendFormat": "{{nodename}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Logs",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 16
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "expr": "{nodename=~\"$host\", unit=~\"$unit\", container=~\"$container\"} |~ \"$level\" |~ \"(?i)$search\" !~ \"(?i)$exclude\"",
          "refId": "A",
          "queryType": "range",
          "maxLines": 2000
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Errors only",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "expr": "{nodename=~\"$host\", unit=~\"$unit\", container=~\"$container\"} |~ \"(?i)(error|fatal|panic|traceback|failed|exception)\" |~ \"(?i)$search\" !~ \"(?i)$exclude\"",
          "refId": "A",
          "queryType": "range",
          "maxLines": 1000
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "signature"
      }
    }
  ]
}
