{
 "uid": "kometa-overview",
 "title": "Kometa",
 "tags": [
  "kometa",
  "plex",
  "media",
  "ocean"
 ],
 "description": "Kometa (formerly Plex Meta Manager) nightly collection + overlay runs on ocean. Kometa has no metrics endpoint and a silent stdout, so everything here is parsed out of meta.log by kometa-metrics.sh into the node_exporter textfile collector.",
 "timezone": "browser",
 "editable": true,
 "schemaVersion": 40,
 "version": 1,
 "refresh": "5m",
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "panels": [
  {
   "type": "row",
   "title": "Health",
   "id": 1,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "collapsed": false,
   "panels": []
  },
  {
   "type": "stat",
   "title": "Last run outcome",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "bf02tpxiz6m0wf"
   },
   "description": "1 when the most recent run logged a CRITICAL. Kometa exits 0 either way and its container stays healthy, so this is the only place a failed run shows up.",
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "OK",
         "color": "green",
         "index": 0
        },
        "1": {
         "text": "FAILED",
         "color": "red",
         "index": 1
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "auto"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "bf02tpxiz6m0wf"
     },
     "editorMode": "code",
     "expr": "kometa_last_run_failed",
     "refId": "A",
     "range": true
    }
   ]
  },
  {
   "type": "stat",
   "title": "Running now",
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "bf02tpxiz6m0wf"
   },
   "description": "Set while meta.log is being written. Both Kometa alerts hold off on this, so a long run does not page.",
