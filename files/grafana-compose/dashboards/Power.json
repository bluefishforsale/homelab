{
  "title": "Power",
  "uid": "power",
  "schemaVersion": 40,
  "editable": true,
  "tags": [
    "power",
    "ipmi",
    "emporia",
    "cost",
    "ups"
  ],
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Draw now",
      "description": "IPMI DCMI is PSU input power. The homelab plug feeds both nodes, so homelab minus IPMI is the network gear plus anything else on that plug. PoE is only what UniFi switches deliver to PoE devices, not the switches' own draw.",
      "datasource": {
        "type": "prometheus",
        "uid": "bf02tpxiz6m0wf"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "label_replace(ipmi_dcmi_power_consumption_watts, \"device\", \"$1\", \"instance\", \"([^.]+).*\")",
          "legendFormat": "{{device}}",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "bf02tpxiz6m0wf"
          },
          "refId": "A"
        },
        {
          "expr": "emporia_power_watts",
          "legendFormat": "plug: {{device}}",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "bf02tpxiz6m0wf"
          },
          "refId": "B"
        },
        {
          "expr": "sum(emporia_power_watts{device=\"homelab\"}) - sum(ipmi_dcmi_power_consumption_watts)",
          "legendFormat": "network + other (homelab plug - IPMI)",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "bf02tpxiz6m0wf"
          },
          "refId": "C"
        },
        {
          "expr": "sum(unifi_device_port_poe_watts)",
          "legendFormat": "PoE delivered (UniFi)",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "bf02tpxiz6m0wf"
          },
          "refId": "D"
        },
        {
          "expr": "sum(network_ups_tools_ups_load * network_ups_tools_ups_realpower_nominal / 100)",
          "legendFormat": "UPS total output (NUT)",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "bf02tpxiz6m0wf"
          },
          "refId": "E"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name"
      }
    },
