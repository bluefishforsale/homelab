{
  "title": "Power",
  "uid": "power",
  "schemaVersion": 40,
  "editable": true,
  "tags": [
    "power",
    "ipmi",
    "emporia"
  ],
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Draw now",
      "description": "IPMI DCMI is PSU input power. The homelab plug feeds both nodes, so homelab minus IPMI is the network gear plus anything else on that plug. PoE is only what UniFi switches deliver to PoE devices, not the switches' own draw.",
      "datasource": {
        "type": "prometheus",
        "uid": "bf02tpxiz6m0wf"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "label_replace(ipmi_dcmi_power_consumption_watts, \"device\", \"$1\", \"instance\", \"([^.]+).*\")",
          "legendFormat": "{{device}}",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "bf02tpxiz6m0wf"
          },
          "refId": "A"
        },
        {
          "expr": "emporia_power_watts",
          "legendFormat": "plug: {{device}}",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "bf02tpxiz6m0wf"
          },
          "refId": "B"
        },
        {
          "expr": "sum(emporia_power_watts{device=\"homelab\"}) - sum(ipmi_dcmi_power_consumption_watts)",
          "legendFormat": "network + other (homelab plug - IPMI)",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "bf02tpxiz6m0wf"
          },
          "refId": "C"
        },
        {
          "expr": "sum(unifi_device_port_poe_watts)",
          "legendFormat": "PoE delivered (UniFi)",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "bf02tpxiz6m0wf"
          },
          "refId": "D"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Power draw",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "bf02tpxiz6m0wf"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "label_replace(ipmi_dcmi_power_consumption_watts, \"device\", \"$1\", \"instance\", \"([^.]+).*\")",
          "legendFormat": "{{device}}",
          "datasource": {
            "type": "prometheus",
            "uid": "bf02tpxiz6m0wf"
          },
          "refId": "A"
        },
        {
          "expr": "emporia_power_watts",
          "legendFormat": "plug: {{device}}",
          "datasource": {
            "type": "prometheus",
            "uid": "bf02tpxiz6m0wf"
          },
          "refId": "B"
        },
        {
          "expr": "sum(emporia_power_watts{device=\"homelab\"}) - sum(ipmi_dcmi_power_consumption_watts)",
          "legendFormat": "network + other (homelab plug - IPMI)",
          "datasource": {
            "type": "prometheus",
            "uid": "bf02tpxiz6m0wf"
          },
          "refId": "C"
        },
        {
          "expr": "sum(unifi_device_port_poe_watts)",
          "legendFormat": "PoE delivered (UniFi)",
          "datasource": {
            "type": "prometheus",
            "uid": "bf02tpxiz6m0wf"
          },
          "refId": "D"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Energy over selected range",
      "description": "Mean watts over the dashboard range times its length. Gaps are averaged over rather than counted as zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "bf02tpxiz6m0wf"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "avg_over_time((label_replace(ipmi_dcmi_power_consumption_watts, \"device\", \"$1\", \"instance\", \"([^.]+).*\"))[$__range:1m]) * $__range_s / 3600 / 1000",
          "legendFormat": "{{device}}",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "bf02tpxiz6m0wf"
          },
          "refId": "A"
        },
        {
          "expr": "avg_over_time((emporia_power_watts)[$__range:1m]) * $__range_s / 3600 / 1000",
          "legendFormat": "plug: {{device}}",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "bf02tpxiz6m0wf"
          },
          "refId": "B"
        },
        {
          "expr": "avg_over_time((sum(emporia_power_watts{device=\"homelab\"}) - sum(ipmi_dcmi_power_consumption_watts))[$__range:1m]) * $__range_s / 3600 / 1000",
          "legendFormat": "network + other (homelab plug - IPMI)",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "bf02tpxiz6m0wf"
          },
          "refId": "C"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Daily energy",
      "description": "Trailing 24h energy, sampled once a day.",
      "datasource": {
        "type": "prometheus",
        "uid": "bf02tpxiz6m0wf"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "decimals": 1,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "avg_over_time((label_replace(ipmi_dcmi_power_consumption_watts, \"device\", \"$1\", \"instance\", \"([^.]+).*\"))[1d:1m]) * 24 / 1000",
          "legendFormat": "{{device}}",
          "interval": "1d",
          "datasource": {
            "type": "prometheus",
            "uid": "bf02tpxiz6m0wf"
          },
          "refId": "A"
        },
        {
          "expr": "avg_over_time((emporia_power_watts)[1d:1m]) * 24 / 1000",
          "legendFormat": "plug: {{device}}",
          "interval": "1d",
          "datasource": {
            "type": "prometheus",
            "uid": "bf02tpxiz6m0wf"
          },
          "refId": "B"
        },
        {
          "expr": "avg_over_time((sum(emporia_power_watts{device=\"homelab\"}) - sum(ipmi_dcmi_power_consumption_watts))[1d:1m]) * 24 / 1000",
          "legendFormat": "network + other (homelab plug - IPMI)",
          "interval": "1d",
          "datasource": {
            "type": "prometheus",
            "uid": "bf02tpxiz6m0wf"
          },
          "refId": "C"
        }
      ],
      "timeFrom": "30d",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Emporia plug reporting",
      "description": "1 when the last cloud poll returned a reading for this plug.",
      "datasource": {
        "type": "prometheus",
        "uid": "bf02tpxiz6m0wf"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "emporia_up",
          "legendFormat": "{{device}}",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "bf02tpxiz6m0wf"
          },
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Since last full Emporia poll",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "bf02tpxiz6m0wf"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "time() - emporia_exporter_last_success_timestamp_seconds",
          "legendFormat": "age",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "bf02tpxiz6m0wf"
          },
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name"
      }
    }
  ]
}
