        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "description": "Average time a worker spent on each successful transcode that finished in the last 24h, from the worker starting it to the job ending. Not from staging: a file can sit in a node's staging slot for a day behind bumped files, which is what used to put 1 day on ocean's max. Counts only jobs the exporter saw running, so it fills in over the 24h after an exporter restart."
    },
    {
      "id": 25,
      "type": "stat",
      "title": "Avg transcode time per file",
      "datasource": {
