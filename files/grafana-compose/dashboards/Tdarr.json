      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "description": "Whole-library file counts, not per node: Tdarr queues files globally. pending = waiting for a transcode decision, staged = handed to a node slot, success/error = transcode outcome, health_* = health check outcome."
    },
    {
      "id": 26,
      "type": "stat",
      "title": "Queue burn-down (est.)",
      "datasource": {
        "type": "prometheus",
        "uid": "bf02tpxiz6m0wf"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(tdarr_queue_video_seconds{codec!=\"hevc\"}) * 24 / avg_over_time(sum(tdarr_worker_fps)[24h:5m])",
          "legendFormat": "burn-down",
          "datasource": {
            "type": "prometheus",
            "uid": "bf02tpxiz6m0wf"
          },
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "description": "How long the pending queue takes to encode at the last 24h's average frames per second across all workers. Frames are estimated as the pending non-HEVC video length times 24 fps, since tdarr stores no frame rate; HEVC files are left out because they skip the encode. Rough: the fps average also includes fast audio-only passes, and the queue is re-read every 15 minutes."
    },
