        "w": 4,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(tdarr_job_processing_seconds_sum{node=~\"$node\",type=\"transcode\"}) / sum(tdarr_job_processing_count{node=~\"$node\",type=\"transcode\"})",
          "legendFormat": "all nodes",
          "datasource": {
            "type": "prometheus",
            "uid": "bf02tpxiz6m0wf"
          },
          "refId": "A",
