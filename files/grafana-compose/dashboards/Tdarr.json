    {
      "id": 14,
      "type": "bargauge",
      "title": "Transcode time per file, 24h avg",
      "datasource": {
        "type": "prometheus",
        "uid": "bf02tpxiz6m0wf"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (node) (tdarr_job_processing_seconds_sum{node=~\"$node\",type=\"transcode\"}) / sum by (node) (tdarr_job_processing_count{node=~\"$node\",type=\"transcode\"})",
          "legendFormat": "{{node}}",
          "datasource": {
            "type": "prometheus",
            "uid": "bf02tpxiz6m0wf"
          },
          "refId": "A",
          "instant": true
