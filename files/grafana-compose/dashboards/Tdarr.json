{
  "uid": "tdarr",
  "title": "Tdarr",
  "tags": [
    "tdarr",
    "media"
  ],
  "schemaVersion": 40,
  "version": 1,
  "editable": true,
  "refresh": "2m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "bf02tpxiz6m0wf"
        },
        "query": {
          "query": "label_values(tdarr_jobs, node)",
          "refId": "node"
        },
        "definition": "label_values(tdarr_jobs, node)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": []
