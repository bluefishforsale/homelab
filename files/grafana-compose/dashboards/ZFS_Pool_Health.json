    {
      "id": 100,
      "type": "stat",
      "title": "Redundancy budget \u2014 disks each pool can still lose",
      "description": "Failure budget = vdev parity minus non-ONLINE disks (raidz2=2, N-way mirror=N-1). Any DEGRADED / REMOVED / mid-replace disk counts as consumed, so this is the conservative margin still in hand. 0 = at the edge: one more loss risks data. Pool value is the min across its vdevs.",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "bf02tpxiz6m0wf"
      },
      "targets": [
        {
          "expr": "min by (pool) (zpool_vdev_redundancy_budget{instance=~\"$host\"})",
          "legendFormat": "{{pool}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
