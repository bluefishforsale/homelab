    {
      "type": "timeseries",
      "title": "Search latency",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "bf02tpxiz6m0wf"
      },
      "description": "Quantiles over a rolling 60m window; the grey bars are how many requests they rest on. A homelab is quiet, so a p95 built from one request is common and means nothing. The recall hook gives a whole search 6s and fails silent, so sustained time above that line means sessions start with no memory and no error.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 6000
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "samples (60m)"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.drawStyle",
                "value": "bars"
              },
              {
                "id": "custom.fillOpacity",
                "value": 25
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisLabel",
                "value": "requests in window"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bf02tpxiz6m0wf"
          },
          "editorMode": "code",
          "expr": "mem0_request_latency_ms{path=\"/search\",quantile=\"0.5\"}",
          "refId": "A",
          "range": true,
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bf02tpxiz6m0wf"
          },
          "editorMode": "code",
          "expr": "mem0_request_latency_ms{path=\"/search\",quantile=\"0.95\"}",
          "refId": "B",
          "range": true,
          "legendFormat": "p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bf02tpxiz6m0wf"
          },
          "editorMode": "code",
          "expr": "mem0_request_latency_ms{path=\"/search\",quantile=\"max\"}",
          "refId": "C",
          "range": true,
          "legendFormat": "max"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bf02tpxiz6m0wf"
          },
