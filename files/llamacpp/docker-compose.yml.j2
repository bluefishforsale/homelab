services:
  llamacpp:
    image: {{ image }}:{{ version }}
    container_name: {{ service }}
    hostname: {{ service }}
    restart: unless-stopped
    
    # GPU support with explicit device reservation
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu, compute, utility]
    
    environment:
      - TZ=America/Los_Angeles
      - NVIDIA_VISIBLE_DEVICES=all
      - NVIDIA_DRIVER_CAPABILITIES=all
      - CUDA_VISIBLE_DEVICES=0
    
    ports:
      - "{{ port }}:{{ port }}"
    
    volumes:
      - /usr/share/zoneinfo:/usr/share/zoneinfo:ro
      - {{ home }}/models:/models
      - {{ home }}/config:/config
      - {{ home }}/logs:/logs
    
    # RTX 3090: the model is llamacpp_active_model (vars_llamacpp_models.yaml).
    # Weights + q8_0 KV @ 32K must fit the 24GB card; measured Plex NVENC only
    # costs ~0.9GB. --jinja loads the model's tool-call chat template (required
    # for tool-calling). Verify at deploy: CUDA 12.8+ in the image (13.2
    # reportedly produces gibberish); sanity-test a tool round-trip before
    # trusting it in the agent loop.
{% set active = llamacpp_models.values() | sum(start=[]) | selectattr('name', 'equalto', llamacpp_active_model) | first %}
    command:
      - "--host"
      - "0.0.0.0"
      - "--port"
      - "{{ port }}"
      - "--model"
      - "/models/{{ llamacpp_active_model }}"
      - "--n-gpu-layers"
      - "-1"
      # Four slots sharing one KV pool, so mem0, AxiomD, and Open WebUI stop
      # queueing behind each other's long thinking runs. Unified means any one
      # slot can still use the whole pool, which a 60k-token eval answer needs.
      # Only 16 of 64 layers hold KV, so 128K of q8_0 is ~4GB on top of the
      # ~17.4GB in use with one 32K slot.
      - "--ctx-size"
      - "131072"
      - "--parallel"
      - "4"
      - "--kv-unified"
      - "--batch-size"
      - "2048"
      - "--ubatch-size"
      - "512"
      - "--flash-attn"
      - "on"
      - "--cache-type-k"
      - "q8_0"
      - "--cache-type-v"
      - "q8_0"
      - "--jinja"
      - "--api-key-file"
      - "/config/keys.txt"
      # API only — the built-in chat UI at / is unauthenticated, so disable
      # it now that the server is reachable through llama.terrac.com.
      - "--no-webui"
      - "--metrics"
      - "--verbose"
      # Per-model server defaults (the card's sampling), so a rollback to
      # another model drops them with it. A request's own params still win.
{% for arg in active.server_args | default([]) %}
      - "{{ arg }}"
{% endfor %}
    
    # Health check - check if server is responding. Must be an unauthenticated
    # route: --api-key-file guards /v1/*, so probing /v1/models returns 401 and
    # curl -f fails even when the server is fine. /health is not behind the key.
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:{{ port }}/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      # A cold load after a reboot took ~3m07s on 2026-10-18 and tripped 60s+5x30s.
      # A passing probe ends start_period early, so warm starts still go healthy fast.
      start_period: 300s
    
    # Note: Running as root for CUDA/GPU access
    # The llama.cpp container requires root for proper GPU memory allocation
    
    # Security options
    security_opt:
      - no-new-privileges:true
    
    # Use default bridge network mode (same as existing containers)
    network_mode: bridge
