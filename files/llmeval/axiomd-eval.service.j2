[Unit]
Description=axiomd eval: grade the 395 candidates against the baseline
# Answers need every model on disk; a half-downloaded set would stall the run
# on the first missing model instead of failing here.
Requires=llmeval-models.service llmeval.service
After=llmeval-models.service llmeval.service

[Service]
# NOTE: simple, not oneshot. A oneshot stays "activating" for the whole run, and
# systemd skips ExecStop for a unit that never went active, so a stop killed
# only the docker client and left the container running (2026-11-08 and -11).
Type=simple
# Resumable: finished answers and verdicts in {{ home }}/out are kept, so a
# restart picks up at the first missing one.
# The PEM key is multi-line, which no env file can carry, so the shell reads it
# from its 0600 file. NOTE: it is exported and passed as a bare `-e NAME`, which
# docker fills from its own environment; `-e NAME=value` would put the key in
# docker's argv, readable by any local user through ps. $$ is systemd's escape
# for a literal $, so the shell expands it, not systemd.
ExecStart=/bin/sh -c 'AXIOMD_APP_PRIVATE_KEY="$$(cat {{ home }}/config/app-key.pem)" \
  && export AXIOMD_APP_PRIVATE_KEY \
  && exec /usr/bin/docker run --rm --name axiomd-eval \
  --env-file {{ home }}/config/eval.env \
  -e AXIOMD_APP_PRIVATE_KEY \
  -v {{ home }}/out:/out \
  {{ axiomd_image }} eval --out /out'
TimeoutStartSec=infinity
# NOTE: killing the docker client leaves the container running. On 2026-11-08
# a stop did exactly that, and the orphan kept generating against a restarted
# router until it mailed a false STALLED.
ExecStop=/usr/bin/docker stop -t 30 axiomd-eval
