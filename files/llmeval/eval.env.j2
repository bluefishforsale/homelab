# Plain KEY=VALUE: read by both docker --env-file and systemd, neither of which
# takes quotes or multi-line values. The app's PEM key lives in app-key.pem.
AXIOMD_APP_CLIENT_ID={{ axiomd.github_app.client_id }}
ANTHROPIC_API_KEY={{ ai_services.claude.axiomd.api_key }}
LLMEVAL_API_KEY={{ llmeval_api_key }}
NTFY_USER={{ ntfy.user }}
NTFY_PASS={{ ntfy.password }}
NTFY_URL={{ llmeval_ntfy_url }}
