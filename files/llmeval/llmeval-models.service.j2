[Unit]
Description=Download and verify llmeval's GGUF models
Wants=network-online.target
After=network-online.target
# Skipped once this exact model list is downloaded and verified.
ConditionPathExists=!{{ home }}/models/.verified-{{ llmeval_models_digest }}

[Service]
Type=oneshot
EnvironmentFile={{ home }}/config/eval.env
ExecStart=/usr/local/sbin/llmeval-models
# NOTE: the router lists /models only at startup, so without this restart it
# keeps serving the empty list it saw before the download and every eval
# request 404s on its model name.
ExecStartPost=/bin/systemctl restart llmeval.service
# ~204 GB on a home link.
TimeoutStartSec=infinity
