#!/usr/bin/env bash
# Download every eval model, verifying each file's sha256 against Hugging Face's
# LFS oid. About 204 GB, so it runs as a systemd job rather than inside a CI
# deploy. Idempotent: a file already present with the right hash is skipped.
set -euo pipefail
MODELS={{ home }}/models

fail() {
  # Credentials go to curl on stdin (-K -), never in argv, where ps shows them.
  printf 'user = "%s:%s"\n' "$NTFY_USER" "$NTFY_PASS" \
    | curl -sf --max-time 10 -K - -H "Title: llmeval model download failed" \
      -H "Priority: high" -d "$1" "$NTFY_URL" >/dev/null || true
  echo "$1" >&2
  exit 1
}

fetch() {  # url sha256 dest
  local url="$1" sum="$2" dest="$3"
  if [ -f "$dest" ] && echo "$sum  $dest" | sha256sum -c --quiet 2>/dev/null; then
    return 0
  fi
  mkdir -p "$(dirname "$dest")"
  curl -fL --retry 5 --retry-delay 30 -C - -o "$dest.part" "$url" || fail "download failed: $url"
  echo "$sum  $dest.part" | sha256sum -c --quiet || { rm -f "$dest.part"; fail "checksum mismatch: $url"; }
  mv "$dest.part" "$dest"
  echo "ok $dest"
}

{% for m in llmeval_models %}
{% for f in m.files %}
fetch "{{ f.url }}" "{{ f.sha256 }}" "$MODELS/{% if m.dir | default(false) %}{{ m.name }}/{% endif %}{{ f.url | basename }}"
{% endfor %}
{% endfor %}

touch "$MODELS/.verified-{{ llmeval_models_digest }}"
