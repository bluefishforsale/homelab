#!/bin/sh
# {{ ansible_managed }}
# The runner runs this before every job (ACTIONS_RUNNER_HOOK_JOB_STARTED), and
# a non-zero exit fails the job before any of its steps run.
#
# NOTE: {{ runner_repo }} is public. Any workflow file in it can ask for this
# runner, and a fork's pull request can edit one to do so; user accounts have
# no runner groups to stop that. This hook is the gate: only release.yml, from
# a v* tag push or a dispatch of main, runs here. Jobs share this user's caches
# (~/.cargo and the like) with the signing runs, so nothing else may.
set -eu

workflow="${GITHUB_WORKFLOW_REF%%@*}"
case "${GITHUB_EVENT_NAME:-}:${GITHUB_REF:-}" in
  push:refs/tags/v*|workflow_dispatch:refs/heads/main) ;;
  *)
    echo "mini-tv runs only tag pushes and dispatches, not ${GITHUB_EVENT_NAME:-?} on ${GITHUB_REF:-?}" >&2
    exit 1
    ;;
esac
if [ "$workflow" != "{{ runner_repo }}/.github/workflows/release.yml" ]; then
  echo "mini-tv runs only release.yml, not $workflow" >&2
  exit 1
fi
