[Unit]
Description=ml-log-analyzer (detector, processor, postgres, redis) (Docker Compose)
Documentation=https://github.com/bluefishforsale/ml-log-analyzer
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service
# harbor's local state disk, never ocean's NFS view of the same path.
RequiresMountsFor=/data01/services

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ home }}

Environment=COMPOSE_PROJECT_NAME={{ service }}
Environment=COMPOSE_HTTP_TIMEOUT=60
Environment=PATH=/usr/local/bin:/usr/bin:/bin

ExecStartPre=/bin/bash -c 'cd {{ home }} && /usr/bin/docker compose down'
# Tolerant (leading '-') so a host reboot during a registry blip still starts
# on the cached image; the deploy-time pull is the loud guard.
ExecStartPre=-/bin/bash -c 'cd {{ home }} && /usr/bin/docker compose pull'

ExecStart=/bin/bash -c 'cd {{ home }} && /usr/bin/docker compose up -d'
ExecStop=/bin/bash -c 'cd {{ home }} && /usr/bin/docker compose down'

Restart=on-failure
RestartSec=30
TimeoutStartSec=600
TimeoutStopSec=60

NoNewPrivileges=true
ReadWritePaths={{ home }}
ReadOnlyPaths=/var/run/docker.sock

StandardOutput=journal
StandardError=journal
SyslogIdentifier={{ service }}

[Install]
WantedBy=multi-user.target
