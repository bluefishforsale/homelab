# my-ta-jose - environment file
# Rendered from files/my_ta_jose/my_ta_jose.env.j2 with values from vault/secrets.yaml
# Vault keys live under the top-level `my_ta_jose:` group.

# LLM endpoint. llama.cpp is published on the host; reach it via the compose
# network's host gateway (see extra_hosts in docker-compose.yml.j2). This used
# to be the docker0 gateway 172.17.0.1 back when the container ran on docker0.
LLAMACPP_BASE_URL=http://host.docker.internal:{{ service_ports.llamacpp.port }}
LLAMACPP_MODEL={{ my_ta_jose.llamacpp_model | default('Qwen3-14B-Q4_K_M') }}
LLAMACPP_API_KEY='{{ ai_services.llamacpp.api_keys.my_ta_jose | default("") }}'

# Bind address inside the container
APP_HOST=0.0.0.0
APP_PORT={{ port_int }}

# Sign-in is Google-only (no passwords). SESSION_SECRET signs the session
# cookies; rotating it signs everyone out.
SESSION_SECRET='{{ my_ta_jose.session_secret | default("UNSET") }}'
SESSION_MAX_AGE_SECONDS={{ my_ta_jose.session_max_age_seconds | default(86400) }}
COOKIE_SECURE={{ my_ta_jose.cookie_secure | default('true') }}
DATABASE_PATH=/app/data/my_ta_jose.db

# Google sign-in, the only way in. Empty starts the app but nobody can sign in;
# /login says "Sign-in is not configured."
#
# NOTE: PUBLIC_BASE_URL must match the Authorized redirect URI in Google Cloud
# Console character for character, or the flow fails with redirect_uri_mismatch,
# which surfaces at Google and not in our logs. Hardcoded on purpose: deriving
# it from a request header is how OAuth open-redirects happen, and nginx
# forwards Host.
PUBLIC_BASE_URL=https://ta.terrac.com

# Single-quoted: compose v2 reads an unquoted `$` as interpolation, and a client
# secret may contain one.
GOOGLE_CLIENT_ID='{{ my_ta_jose.google_oauth.id | default("") }}'
GOOGLE_CLIENT_SECRET='{{ my_ta_jose.google_oauth.secret | default("") }}'
