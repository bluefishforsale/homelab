# my-ta-jose - environment file
# Rendered from files/my_ta_jose/my_ta_jose.env.j2 with values from vault/secrets.yaml
# Vault keys live under the top-level `my_ta_jose:` group.

# LLM endpoint. llama.cpp is published on the host; reach it via the compose
# network's host gateway (see extra_hosts in docker-compose.yml.j2). This used
# to be the docker0 gateway 172.17.0.1 back when the container ran on docker0.
LLAMACPP_BASE_URL=http://host.docker.internal:{{ service_ports.llamacpp.port }}
LLAMACPP_MODEL={{ my_ta_jose.llamacpp_model | default('Qwen3-14B-Q4_K_M') }}
LLAMACPP_API_KEY='{{ ai_services.llamacpp.api_keys.my_ta_jose | default("") }}'

# Bind address inside the container
APP_HOST=0.0.0.0
APP_PORT={{ port_int }}

# Phase-2A authentication.
#
# Password lives in the SQLite DB (data/my_ta_jose.db, mounted volume) so the
# end user can rotate it via /password. APP_INITIAL_PASSWORD_HASH is used
# ONLY on first boot to seed the row; ignored once the row exists. After
# seeding, the operator can blank this value if they want.
#
# SESSION_SECRET signs the session cookies; rotating it invalidates all
# existing sessions (acceptable for one user).
#
# Defaults are intentional placeholders. Missing the hash makes init_db
# raise and the container crash-loops — better than running unauthenticated.
#
# IMPORTANT: argon2 hashes contain `$` characters that docker-compose v2
# treats as variable interpolation in unquoted env_file values. Single-quote
# the hash so compose passes it through literally.
APP_INITIAL_PASSWORD_HASH='{{ my_ta_jose.initial_password_hash | default("") }}'
SESSION_SECRET='{{ my_ta_jose.session_secret | default("UNSET") }}'
SESSION_MAX_AGE_SECONDS={{ my_ta_jose.session_max_age_seconds | default(86400) }}
COOKIE_SECURE={{ my_ta_jose.cookie_secure | default('true') }}
DATABASE_PATH=/app/data/my_ta_jose.db

# Recovery token for /forgot. One-time use per value: a successful reset
# stores the token's sha256 in the DB and that exact token can't be used
# again. To issue a fresh token, rotate this value in the vault.
APP_RECOVERY_TOKEN='{{ my_ta_jose.recovery_token | default("") }}'

# Google sign-in, consumed by the app's /auth/google/* routes. Empty is a
# supported state, hence "" defaults rather than the deliberate crash on
# APP_INITIAL_PASSWORD_HASH above.
#
# NOTE: what makes shipping this ahead of the app safe TODAY is that the
# deployed app has no /auth/google/* routes at all, not these values. Once it
# does, it serves them only when BOTH are non-empty, so a half-set pair reads as
# "feature off" rather than erroring, and reads that way silently: nothing here
# probes it, so a blanked secret looks identical to never having enabled it.
#
# PUBLIC_BASE_URL builds the callback the app hands to Google and must match the
# Authorized redirect URI in Google Cloud Console character for character, or the
# flow fails with redirect_uri_mismatch, which surfaces at Google and not in our
# logs. Hardcoded: there is one deployment and a vault override would be dead.
PUBLIC_BASE_URL=https://ta.terrac.com

# Single-quoted like the argon2 hash above: compose v2 reads an unquoted `$` as
# interpolation, and a client secret may contain one.
GOOGLE_CLIENT_ID='{{ my_ta_jose.google_oauth.id | default("") }}'
GOOGLE_CLIENT_SECRET='{{ my_ta_jose.google_oauth.secret | default("") }}'
