# Rendered by playbooks/individual/ocean/monitoring/ndt_speedtest.yaml.
#
# The image is built here from repo source, not pulled from a registry. The
# `build:` key is what makes that safe for the weekly refresh: docker-refresh
# pulls with --ignore-buildable, so this project is skipped rather than failing
# every week on a tag that exists in no registry. Its real update path is a
# change to exporter.py, which rebuilds on the next apply.
services:
  ndt-speedtest-exporter:
    build: .
    image: "{{ ndt_exporter_image }}"
    container_name: "{{ ndt_exporter_service }}"
    hostname: "{{ ndt_exporter_service }}"
    environment:
      TZ: America/Los_Angeles
      NDT_INTERVAL_SECONDS: "{{ ndt_exporter_interval }}"
      NDT_MAX_SERVERS: "{{ ndt_exporter_max_servers }}"
    ports:
      - "{{ ndt_exporter_port }}:9140"
    restart: unless-stopped
