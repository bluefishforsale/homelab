[Unit]
Description=netboot one-shot next-boot flags
After=network.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/sbin/netboot-next-boot
DynamicUser=true
StateDirectory=netboot-next-boot
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
Restart=on-failure

[Install]
WantedBy=multi-user.target
