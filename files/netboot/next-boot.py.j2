#!/usr/bin/env python3
"""One-shot next-boot flags for netboot hosts (docs/specs/2026-10-29-netboot-design.md).

POST /next-boot/<host>?target=tdarr|windows sets the flag; the dns pair's
menu.ipxe GETs /next-boot/<mac-hyphenated>.ipxe on every PXE boot, and the
GET that finds a flag consumes it. nginx proxies /next-boot/ here and keeps
it LAN-only.

Only targets that never write a disk exist, so a flag can never turn a reboot
into an install.
"""
import os
import re
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlsplit

FLAG_DIR = "{{ netboot_next_boot_dir }}"
HOSTS = {
{% for name, host in netboot_hosts.items() %}
    "{{ name }}": "{{ host.mac | replace(':', '-') | lower }}",
{% endfor %}
}
TARGETS = {"tdarr": "live", "windows": "local"}
MAC = re.compile(r"^/next-boot/([0-9a-f]{2}(?:-[0-9a-f]{2}){5})\.ipxe$")
HOST = re.compile(r"^/next-boot/([a-z0-9-]+)$")


class Handler(BaseHTTPRequestHandler):
    def reply(self, code, body):
        data = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        path = urlsplit(self.path).path
        if path == "/next-boot/healthz":
            return self.reply(200, "ok\n")
        m = MAC.match(path)
        if not m:
            return self.reply(404, "not found\n")
        flag = os.path.join(FLAG_DIR, m.group(1))
        try:
            with open(flag) as f:
                entry = f.read().strip()
            os.unlink(flag)
        except FileNotFoundError:
            return self.reply(404, "no flag\n")
        self.reply(200, f"#!ipxe\nset menu-default {entry}\nset menu-timeout 3000\n")

    def do_POST(self):
        url = urlsplit(self.path)
        m = HOST.match(url.path)
        target = parse_qs(url.query).get("target", [""])[0]
        if not m or m.group(1) not in HOSTS:
            return self.reply(404, "unknown host\n")
        if target not in TARGETS:
            return self.reply(400, f"target must be one of {', '.join(sorted(TARGETS))}\n")
        flag = os.path.join(FLAG_DIR, HOSTS[m.group(1)])
        with open(flag + ".tmp", "w") as f:
            f.write(TARGETS[target] + "\n")
        os.replace(flag + ".tmp", flag)
        self.reply(200, f"{m.group(1)} boots {target} next time\n")


if __name__ == "__main__":
    ThreadingHTTPServer(("127.0.0.1", {{ netboot_next_boot_port }}), Handler).serve_forever()
