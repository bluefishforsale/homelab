#!/bin/bash
# Rendered by playbooks/individual/infrastructure/netboot.yaml.
#
# tdarr-gpu role: a diskless live host (the gaming tower's 4090) joins ocean's
# tdarr server as a GPU node. The ephemeral cousin of
# playbooks/individual/workers/tdarr_node.yaml: same image pinning, same
# in-container paths, but everything here lives in RAM and is rebuilt per boot.
# Local disks are never touched; the transcode cache is a capped tmpfs.
set -euo pipefail

SERVER_IP={{ tdarr_server_ip }}
SERVER_URL=http://$SERVER_IP:{{ service_ports.tdarr.port }}
NODE_NAME=$(hostname).home
HOME_DIR=/srv/tdarr-node

# The journal lives in RAM here, so whatever the kernel said before an
# unattended restart (MCE, Xid, OOM) is gone at the next boot unless it was
# already in Loki. Started first so it runs even when the tdarr setup fails.
# NOTE: the image's apt promtail, not grafana/promtail: that image is built
# without journal support and shipped nothing (2026-11-03).
cat >/etc/promtail/config.yml <<EOF
server:
  http_listen_port: 9080
  grpc_listen_port: 0
positions:
  filename: /tmp/positions.yaml
clients:
  - url: {{ loki_push_url }}
scrape_configs:
  - job_name: journal
    journal:
      max_age: 12h
      labels:
        job: netboot
        host: $(hostname)
    relabel_configs:
      - source_labels: ['__journal__systemd_unit']
        target_label: unit
      - source_labels: ['__journal_syslog_identifier']
        target_label: syslog_identifier
      - source_labels: ['__journal_container_name']
        target_label: container
        regex: '(.+)'
EOF
systemctl restart promtail

# A node refuses a server of another version, and a version baked into the
# image at build time would drift, so pin to whatever the server runs now.
VERSION=$(curl -fsS "$SERVER_URL/api/v2/status" | jq -r .version)
[[ "$VERSION" =~ ^[0-9]+\.[0-9]{2}\.[0-9]{2}$ ]] || { echo "tdarr server reported version '$VERSION'" >&2; exit 1; }

# ocean exports only the library to netboot hosts (nfs_export_data01.yaml).
mkdir -p /data01/complete
mountpoint -q /data01/complete || mount -t nfs4 -o {{ tdarr_gpu_nfs_opts }} "$SERVER_IP:/data01/complete" /data01/complete

# NOTE: the cap is what turns a full cache into one failed job (tdarr retries
# it) instead of the OOM killer taking the whole node down with 64 GB of RAM.
mkdir -p "$HOME_DIR/cache" "$HOME_DIR/configs" "$HOME_DIR/logs"
mountpoint -q "$HOME_DIR/cache" || mount -t tmpfs -o size={{ tdarr_gpu_cache_size }},mode=0775,uid={{ system_users.media.uid }},gid={{ system_users.media.gid }} tmpfs "$HOME_DIR/cache"
chown {{ system_users.media.uid }}:{{ system_users.media.gid }} "$HOME_DIR/configs" "$HOME_DIR/logs"

NODE_IP=$(ip -4 route get "$SERVER_IP" | sed -n 's/.* src \([0-9.]*\).*/\1/p')
cat >"$HOME_DIR/docker-compose.yml" <<EOF
services:
  tdarr-node:
    image: ghcr.io/haveagitgat/tdarr_node:$VERSION
    container_name: tdarr-node
    hostname: tdarr-node-$(hostname)
    environment:
      TZ: America/Los_Angeles
      PUID: "{{ system_users.media.uid }}"
      PGID: "{{ system_users.media.gid }}"
      inContainer: "true"
      serverIP: "$SERVER_IP"
      serverPort: "{{ tdarr_server_api_port }}"
      nodeID: "$NODE_NAME"
      nodeName: "$NODE_NAME"
      nodeIP: "$NODE_IP"
      nodePort: "8267"
      NVIDIA_DRIVER_CAPABILITIES: all
      NVIDIA_VISIBLE_DEVICES: all
    volumes:
      - /data01/complete:/media
      - $HOME_DIR/cache:/temp
      - $HOME_DIR/configs:/app/configs
      - $HOME_DIR/logs:/app/logs
    ports:
      - "8267:8267"
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu, video, compute, utility]
    healthcheck:
      test: ["CMD-SHELL", "grep -qas Tdarr_Node /proc/[0-9]*/cmdline"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 60s
    restart: unless-stopped
EOF
docker compose -f "$HOME_DIR/docker-compose.yml" up -d

# GPU metrics for the Better NVIDIA DCGM dashboard, scraped as netboot-dcgm.
# Host networking so its Hostname label is this host's name, as on ocean.
DCGM_DIR=/srv/dcgm-exporter
mkdir -p "$DCGM_DIR"
cat >"$DCGM_DIR/docker-compose.yml" <<EOF
services:
  dcgm-exporter:
    image: {{ dcgm_exporter_image }}
    container_name: dcgm-exporter
    restart: unless-stopped
    privileged: true
    network_mode: host
    healthcheck:
      test: ["CMD", "nvidia-smi"]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
EOF
docker compose -f "$DCGM_DIR/docker-compose.yml" up -d

# Worker limits live on the server, keyed by nodeID, and only move one step
# per API call, so walk each type to its committed count.
NODE_ID=""
for _ in $(seq 1 30); do
  NODE_ID=$(curl -fsS "$SERVER_URL/api/v2/get-nodes" | jq -r --arg n "$NODE_NAME" 'to_entries[] | select(.value.nodeName == $n) | .key' | head -1)
  [[ -n "$NODE_ID" ]] && break
  sleep 10
done
[[ -n "$NODE_ID" ]] || { echo "tdarr server never listed $NODE_NAME" >&2; exit 1; }

# NOTE: the flow's Route Encoder By Worker step encodes with NVENC only on a
# node whose gpuSelect is nvenc. A node registers with '-', and every job on
# the 4090 then ran libx265 on the CPU (2026-10-31).
curl -fsS -X POST -H 'Content-Type: application/json' "$SERVER_URL/api/v2/update-node" \
  -d "$(jq -cn --arg id "$NODE_ID" '{data:{nodeID:$id,nodeUpdates:{gpuSelect:"nvenc"}}}')" >/dev/null

{% for type, want in tdarr_gpu_worker_limits.items() %}
have=$(curl -fsS "$SERVER_URL/api/v2/get-nodes" | jq -r --arg id "$NODE_ID" '.[$id].workerLimits.{{ type }} // 0')
while (( have != {{ want }} )); do
  if (( have < {{ want }} )); then process=increase; have=$((have + 1)); else process=decrease; have=$((have - 1)); fi
  curl -fsS -X POST -H 'Content-Type: application/json' "$SERVER_URL/api/v2/alter-worker-limit" \
    -d "$(jq -cn --arg id "$NODE_ID" --arg p "$process" '{data:{nodeID:$id,process:$p,workerType:"{{ type }}"}}')" >/dev/null
done
{% endfor %}
echo "$NODE_NAME joined tdarr $VERSION as $NODE_ID"

# The server is :latest on ocean and moves on its own; a node left on the old
# version is refused (11-06: a day on 3.04.00 against 3.06.00). Every 5
# minutes, compare and rerun this role on a change, which repins everything
# above. The old container's jobs die with it and leave their workDirs in the
# tmpfs cache (38G of 40G after 11-06), so the node goes down and the cache is
# emptied first.
cat >/usr/local/sbin/tdarr-node-version-sync <<EOF
#!/bin/bash
set -euo pipefail
want=\$(curl -fsS --max-time 20 "$SERVER_URL/api/v2/status" | jq -r .version)
[[ "\$want" =~ ^[0-9]+\.[0-9]{2}\.[0-9]{2}\$ ]] || { echo "tdarr server reported version '\$want'" >&2; exit 1; }
[[ "\$want" == "$VERSION" ]] && exit 0
echo "server is \$want, node is $VERSION: rerunning netboot-role"
docker compose -f "$HOME_DIR/docker-compose.yml" down --timeout 30
find "$HOME_DIR/cache" -mindepth 1 -delete
systemctl restart --no-block netboot-role.service
EOF
chmod 0755 /usr/local/sbin/tdarr-node-version-sync
# NOTE: a transient timer, not unit files: those need systemctl daemon-reload,
# and a reload strips the GPU from running containers (NVML "Unknown Error",
# every NVENC job failed with CUDA_ERROR_NO_DEVICE, 2026-11-07).
systemctl is-active -q tdarr-node-version-sync.timer || \
  systemd-run --unit=tdarr-node-version-sync --on-active=5min --on-unit-active=5min \
    --description="Rerun netboot-role when the tdarr server's version changes" \
    /usr/local/sbin/tdarr-node-version-sync
