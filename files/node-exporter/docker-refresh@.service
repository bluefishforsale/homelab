[Unit]
Description=Refresh images for compose project %i
Documentation=file:///usr/local/bin/docker-refresh.sh
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/docker-refresh.sh %i
# Backstop only, and it must stay above the script's own budgets or it becomes
# the thing it exists to prevent: systemd killing the unit mid-recreate leaves
# the service down, which is the one way this can cause an outage. The script
# bounds the pull at 45m and the recreate at 10m, so 4200 sits past both with
# 10m to spare.
TimeoutStartSec=4200
Nice=10
IOSchedulingClass=idle
