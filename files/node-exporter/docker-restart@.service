[Unit]
Description=Weekly restart of container %i
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# Restarts by container name, not compose project, because that needs no
# compose-file lookup and both users pin container_name explicitly. A plain
# restart is the point: this replaces the RuntimeMaxSec=7d that the old
# `docker run` units carried, for services whose image is built on the host and
# so is never recreated by docker-refresh.
ExecStart=/usr/bin/docker restart %i
Nice=10
