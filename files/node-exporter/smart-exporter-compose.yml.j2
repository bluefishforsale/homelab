version: '3.8'

services:
  smart-exporter:
    image: {{ smart_exporter_image }}:{{ smart_exporter_version }}
    container_name: {{ smart_exporter_service }}
    hostname: {{ inventory_hostname }}
    restart: unless-stopped

    # NOTE: the exporter's exclude regex only matches kernel names (sdf), and
    # those move across reboots, so a hardcoded name would eventually drop a
    # healthy disk instead. Resolving the stable by-id names at container start
    # follows the device, and a by-id absent on this host resolves to nothing.
    entrypoint: ["/bin/sh", "-c"]
    command:
      - |
        ex=""
        for id in {{ smart_exporter_exclude_by_id | join(' ') }}; do
          [ -e "/dev/disk/by-id/$$id" ] && ex="$${ex:+$$ex|}$$(basename "$$(readlink -f "/dev/disk/by-id/$$id")")"
        done
        exec /bin/smartctl_exporter $${ex:+--smartctl.device-exclude=^($$ex)\$$}
    
    # Networking
    ports:
      - "{{ smart_exporter_port }}:9633"
    
    # Maximum privileges for SMART data access
    privileged: true
    user: "0:0"  # Run as root
    
    # Grant all capabilities
    cap_add:
      - ALL
    
    # Remove all security restrictions
    security_opt:
      - apparmor:unconfined
      - seccomp:unconfined
    
    # Mount host devices for SMART monitoring
    volumes:
      - /dev:/dev
      - /proc:/proc
      - /sys:/sys
    
    # Health Check (using wget with built-in timeout)
    healthcheck:
      test: ["CMD", "wget", "--timeout=5", "--tries=1", "--spider", "-q", "http://localhost:9633/metrics"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    
    # Resource Limits
    deploy:
      resources:
        limits:
          memory: 128M
        reservations:
          memory: 64M
    
    # Logging
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    
    # Use default bridge network mode (same as existing containers)
    network_mode: bridge

# No custom networks needed - using default bridge
