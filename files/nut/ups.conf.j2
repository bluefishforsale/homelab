# Rendered by playbooks/individual/base/nut_ups.yaml (nut server only).
# Several UPSes on one USB hub, two of them identical APCs; serial is the only
# thing that tells them apart, and hiddevN/bus numbers reorder on every
# re-enumeration.
maxretry = 3

{% for ups in nut_upses %}
[ups-{{ ups.id }}]
  driver = usbhid-ups
  port = auto
  vendorid = {{ ups.vendorid }}
  productid = {{ ups.productid }}
  # NOTE: NUT full-matches this regex; the APCs pad their serial with spaces and
  # the GoldenMate appends ":23", so an exact string would match no device and
  # the driver would never start.
  serial = "{{ ups.id }}.*"
  desc = "{{ ups.desc }} {{ ups.id }}"
  ignorelb
{% if ups.low_charge is defined %}
  # Raise LB at {{ ups.low_charge }}% charge; this unit's runtime reading is not real.
  override.battery.charge.low = {{ ups.low_charge }}
{% else %}
  # Raise LB at {{ nut_low_runtime_seconds }}s of runtime instead of the UPS's own
  # 2 minutes, which is too little for Proxmox to stop every VM.
  override.battery.runtime.low = {{ nut_low_runtime_seconds }}
{% endif %}

{% endfor %}
