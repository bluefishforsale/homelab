# Rendered by playbooks/individual/base/nut_ups.yaml.
{% set primary = inventory_hostname == nut_server %}
{% for serial in nut_ups_serials %}
MONITOR ups-{{ serial }}@{{ nut_ups_host }} 1 {{ 'upsmon_primary' if primary else 'upsmon_secondary' }} {{ infrastructure.nut.primary_password if primary else infrastructure.nut.secondary_password }} {{ 'primary' if primary else 'secondary' }}
{% endfor %}

# NOTE: shut down when ANY UPS is critical (on battery + low battery). Which UPS
# feeds which PSU is unknown, and all three hang off one wall socket, so an
# outage puts all three on battery at once; the first to run low decides. A UPS
# that is unreachable but was last seen online still counts as powering us, so
# losing node005 (or USB) alone never shuts node006 down.
MINSUPPLIES {{ nut_ups_serials | length }}

# The primary waits for the secondaries to power off first: its own shutdown
# ends by cutting every UPS (POWERDOWNFLAG), and that must not land on a
# secondary still stopping its VMs.
SHUTDOWNCMD "{{ '/usr/local/sbin/nut-shutdown-wait' if primary else '/sbin/shutdown -h +0' }}"
POWERDOWNFLAG /etc/killpower
POLLFREQ 5
POLLFREQALERT 5
HOSTSYNC 15
DEADTIME 15
FINALDELAY 5
