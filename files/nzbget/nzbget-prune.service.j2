[Unit]
Description=Prune failed, orphaned and stale nzbget downloads
After={{ service }}.service
Wants={{ service }}.service
RequiresMountsFor={{ data }} {{ scratch }}

[Service]
Type=oneshot
EnvironmentFile=/etc/nzbget-prune.env
ExecStart=/usr/bin/python3 /usr/local/bin/nzbget-prune
TimeoutStartSec=2h
