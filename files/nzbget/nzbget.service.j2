[Unit]
Description={{ service }}
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
RequiresMountsFor=/data01 /data01/services {{ scratch }}

[Service]
# Compose project so docker-refresh@ sees it; crash recovery is the containers'
# own `restart: unless-stopped`, since Restart= is not valid on a oneshot.
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ home }}
StandardOutput=journal
StandardError=journal
ExecStart=/usr/bin/docker compose up -d
# NOTE: nzbget writes its queue on a clean stop; a short timeout SIGKILLs it
# mid-write and the next start resumes from a torn queue.
ExecStop=/usr/bin/docker compose down --timeout 120
TimeoutStartSec=300
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
