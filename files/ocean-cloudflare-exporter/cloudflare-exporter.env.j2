# Rendered by playbooks/individual/ocean/monitoring/cloudflare_exporter.yaml (mode 0600).
# Scoped READ-ONLY Cloudflare API token (Analytics read) for the
# "{{ cf_account_slug }}" account. Never write access. The exporter polls the
# httpRequests1hGroups GraphQL dataset (Free/Pro compatible) and stores no raw logs.
CF_API_TOKEN={{ cloudflare.exporter_tokens[cf_account_slug] }}
CF_ZONES={{ cf_zones }}
CF_POLL_SECONDS={{ cf_poll_seconds }}
CF_PORT={{ cf_internal_port }}
