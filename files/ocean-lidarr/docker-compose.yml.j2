# Lidarr and its exporter, one compose project so docker-refresh@lidarr keeps
# both images current.
services:
  lidarr:
    image: {{ image }}:{{ version }}
    container_name: {{ service }}
    hostname: {{ service }}
    restart: unless-stopped
    environment:
      - TZ=America/Los_Angeles
      - PUID={{ uid }}
      - PGID={{ gid }}
    ports:
      - "{{ lidarr_port }}:8686"
    # NOTE: the library mount is by-artist, not music/. The database from the
    # 2025 install stores artist paths as /music/<artist>; mounting the parent
    # would orphan every one of them.
    volumes:
      - {{ home }}:/config
      - {{ library }}:/music
      - {{ incoming }}:/downloads
      - /etc/localtime:/etc/localtime:ro
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://localhost:8686/ping || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 120s
    security_opt:
      - no-new-privileges:true
    cpus: '4.0'
    mem_limit: 2048m

  lidarr-exporter:
    image: {{ exporter_image }}:{{ exporter_version }}
    container_name: {{ exporter_service }}
    hostname: {{ exporter_service }}
    restart: unless-stopped
    command: ["lidarr"]
    environment:
      - TZ=America/Los_Angeles
      - URL=http://{{ service }}:8686
      - API_KEY={{ media_services.lidarr.api_key }}
      - PORT=9709
      - ENABLE_ADDITIONAL_METRICS=true
    ports:
      - "{{ exporter_port }}:9709"
    # No healthcheck: the image has no shell. up{job="lidarr-exporter"} covers it.
    # Start-ordering only: gating on Lidarr's health would hold the exporter
    # down for as long as Lidarr's start_period, and the exporter tolerates
    # Lidarr being briefly unavailable on its own.
    depends_on:
      - lidarr
    security_opt:
      - no-new-privileges:true
    cpus: '0.5'
    mem_limit: 256m
