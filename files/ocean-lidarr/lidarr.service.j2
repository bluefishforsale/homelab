[Unit]
Description={{ service }}
After=docker.service zfs-mount.service zfs-import.target network-online.target
Requires=docker.service zfs-mount.service zfs-import.target
Wants=network-online.target
RequiresMountsFor=/data01

[Service]
# Compose project so docker-refresh@ sees it; crash recovery is the container's
# own `restart: unless-stopped`, since Restart= is not valid on a oneshot.
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ home }}
StandardOutput=journal
StandardError=journal
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down --timeout 30
TimeoutStartSec=300
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
