# Upstream's server/Dockerfile plus libpq5, dropped into the clone the way
# Dockerfile.bridge is.
#
# requirements.txt pins `psycopg>=3.2.8`, the pure-python distribution, which
# needs the system libpq at runtime. Upstream's prod image is python:3.12-slim,
# which has no libpq, so the app imports fine and then dies the moment it opens
# a connection:
#   ImportError: no pq wrapper available.
#   - couldn't import psycopg 'python' implementation: libpq library not found
# Their dev image (python:3.12, not slim) ships libpq and hides this, which is
# why the same code runs on a laptop. One apt package is the whole difference:
# `apt-get install libpq5` in the built image makes `import psycopg` return
# 3.3.4.
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq5 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8000
ENV PYTHONUNBUFFERED=1

# No --reload (upstream's CMD has it). The compose file overrides this anyway to
# run the migration first; this keeps a bare `docker run` of the image sane.
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
