# Rendered by playbooks/individual/workers/mem0.yaml. mem0 runs on harbor; every
# client still says ocean.home:{{ port_api }} and :{{ port_mcp }}, so ocean
# carries those connections to harbor as plain TCP. Host headers pass through
# untouched, which is why the bridge still allows ocean's names.
worker_processes 1;

events {
  worker_connections 256;
}

stream {
  # The MCP bridge holds streamable-HTTP sessions open between calls.
  proxy_timeout 1h;
  proxy_connect_timeout 5s;

  server {
    listen {{ port_api }};
    proxy_pass {{ upstream }}:{{ port_api }};
  }

  server {
    listen {{ port_mcp }};
    proxy_pass {{ upstream }}:{{ port_mcp }};
  }
}
