# mem0 server environment, rendered from files/ocean-mem0/mem0.env.j2 with
# values from vault/secrets.yaml. Mode 0600.
#
# Split routing is deliberate: fact extraction decides what is worth
# remembering and gets a frontier model, embeddings stay local so no
# conversation text leaves the house to be vectorised.

# Postgres (pgvector). POSTGRES_DB holds the vectors, APP_DB_NAME the users and
# api keys. Collection name matches the laptop instance so a pg dump of that
# store restores here without re-embedding anything.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD={{ ai_services.mem0.postgres_password }}
POSTGRES_COLLECTION_NAME=mem0_local
APP_DB_NAME=mem0_app

# Embedder: the local ollama sidecar over its OpenAI-compatible route. mem0
# reads OPENAI_BASE_URL for embeddings, so OPENAI_API_KEY is a placeholder that
# ollama ignores but the client library insists on.
OPENAI_API_KEY=sk-local
OPENAI_BASE_URL=http://ollama:11434/v1
# The playbook's thread-pinned derivative of nomic-embed-text, not the stock
# tag: same weights and the same 768 dims, so already-stored vectors stay valid,
# but 0.05s per embedding instead of 34s. See the playbook for why.
MEM0_DEFAULT_EMBEDDER_MODEL={{ embedder_model }}
MEM0_EMBEDDING_DIMS=768

# Fact extraction: the llamacpp service on this same host, not OpenAI. Nothing
# leaves the network now; the embedder above was already local.
#
# Moved off gpt-4o-mini because the OpenAI account ran out of credit and every
# add started failing with 429 insufficient_quota -> 502. Reads were unaffected
# (embeddings are local), so the store looked healthy while recording nothing
# for 21 hours. Capture queued to its outbox rather than losing anything.
#
# Verified against the real ADDITIVE_EXTRACTION_PROMPT before switching: valid
# JSON first try, correct schema, correct user/assistant attribution, 13.3s for
# 7812 prompt tokens. Slower than gpt-4o-mini, and capture is backgrounded, so
# it does not block a turn.
#
# NOTE: spare2, not a mem0-specific key, because the spares are already
# rendered into llamacpp's keys.txt. A new key means restarting llama-server
# and reloading 19.6GB onto the GPU, which would interrupt every other consumer
# for a config change that does not need it. Give mem0 its own key at the next
# natural llamacpp restart.
#
# NOTE: llama-server runs --parallel 1, so extraction serializes with every
# other consumer. A capture that waits too long times out into the outbox and
# replays at the next session start rather than being lost.
MEM0_DEFAULT_LLM_MODEL=/models/Qwen3-Coder-30B-A3B-Instruct-Q4_K_M.gguf
MEM0_LLM_BASE_URL=http://{{ ansible_default_ipv4.address }}:8080/v1
MEM0_LLM_API_KEY={{ ai_services.llamacpp.api_keys.spare2 }}

# Auth. AUTH_DISABLED=true hands every caller a default user (server/auth.py),
# which on a LAN-published port means any device on the wifi can read and
# rewrite the memory. Keep it false.
AUTH_DISABLED=false
ADMIN_API_KEY={{ ai_services.mem0.admin_api_key }}
JWT_SECRET={{ ai_services.mem0.jwt_secret }}

MEM0_TELEMETRY=false
REQUEST_LOG_RETENTION_DAYS=30
