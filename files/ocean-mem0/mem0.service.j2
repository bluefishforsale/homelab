[Unit]
Description=mem0 shared agent memory (Docker Compose)
Documentation=https://github.com/bluefishforsale/mem0
After=docker.service zfs-mount.service zfs-import.target network-online.target
Wants=network-online.target
Requires=docker.service zfs-mount.service zfs-import.target
RequiresMountsFor=/data01

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ home }}

Environment=COMPOSE_PROJECT_NAME={{ service }}
Environment=COMPOSE_HTTP_TIMEOUT=60
Environment=PATH=/usr/local/bin:/usr/bin:/bin

# Still no `compose pull`, though the API image now comes from GHCR: the bridge
# is built from a source clone and publishes to no registry, so a whole-project
# pull would fail on it. Pulling the pinned API tag is the playbook's job, as is
# rebuilding the bridge after a version bump. `up -d` builds anything missing.
ExecStartPre=/bin/bash -c 'cd {{ home }} && /usr/bin/docker compose down'

ExecStart=/bin/bash -c 'cd {{ home }} && /usr/bin/docker compose up -d'
ExecStop=/bin/bash -c 'cd {{ home }} && /usr/bin/docker compose down'
ExecReload=/bin/bash -c 'cd {{ home }} && /usr/bin/docker compose restart'

Restart=on-failure
RestartSec=30
TimeoutStartSec=600
TimeoutStopSec=60

NoNewPrivileges=true
ReadWritePaths={{ home }}
ReadOnlyPaths=/var/run/docker.sock

StandardOutput=journal
StandardError=journal
SyslogIdentifier={{ service }}

[Install]
WantedBy=multi-user.target
