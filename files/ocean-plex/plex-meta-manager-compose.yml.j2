version: '3.8'

services:
  plex-meta-manager:
    image: {{ meta_manager_image }}:{{ meta_manager_version }}
    container_name: plex-meta-manager
    hostname: plex-meta-manager
    restart: unless-stopped
    user: "{{ uid }}:{{ uid }}"
    cpus: 4
    mem_limit: 2g
    security_opt:
      - no-new-privileges:true
    tmpfs:
      - /tmp:noexec,nosuid,size=200m
    environment:
      - TZ=America/Los_Angeles
      - PUID={{ uid }}
      - PGID={{ uid }}
      - VERSION={{ meta_manager_version }}
    volumes:
      - {{ meta_manager_home }}/config:/config:rw
    healthcheck:
      # `test -f` only proved a file existed, so this container reported healthy
      # through nine months of never completing a run. Parsing the config at
      # least catches a truncated or corrupt one. Run freshness deliberately is
      # NOT checked here: a scheduler that legitimately sleeps 23h a day would
      # flap, and anything watching for unhealthy containers would restart it
      # pointlessly. That signal belongs in kometa_last_success_timestamp_seconds
      # and the KometaNotRunning alert instead.
      test: ["CMD-SHELL", "python3 -c \"import yaml,sys; yaml.safe_load(open('/config/config.yml'))\" || exit 1"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 30s

networks:
  default:
    name: plex-meta-manager_default
