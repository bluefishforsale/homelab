groups:
- name: basic_alerts
  rules:
  # High CPU usage alert. ocean runs the tdarr/refetch batch work, which holds it
  # above 80% for long stretches (7d to 2026-10-15: 261 alerting minutes at
  # 80%/5m, 14 issues in three days), and Plex has CPU priority there, so busy
  # is not hurting anyone. It gets the companion rule below. All other hosts
  # alert at 80% for 5m.
  - alert: HighCpuUsage
    expr: 100 - (avg by(instance) (rate(node_cpu_seconds_total{instance!="ocean.home",mode="idle"}[5m])) * 100) > 80
    for: 5m
    labels:
      severity: warning
    annotations:
      summary: "High CPU usage on {{ "{{ $labels.instance }}" }}"
      description: "CPU usage is above 80% for more than 5 minutes on {{ "{{ $labels.instance }}" }}"

  # NOTE: tuned against measured load, not set above it. Over the same 7 days
  # 85%/30m would have fired 0 minutes while the peak was 92%, so this still
  # catches real saturation; a bar above the peak would just mute the alert.
  - alert: HighCpuUsageOcean
    expr: 100 - (avg by(instance) (rate(node_cpu_seconds_total{instance="ocean.home",mode="idle"}[5m])) * 100) > 85
    for: 30m
    labels:
      severity: warning
    annotations:
      summary: "Sustained high CPU usage on {{ "{{ $labels.instance }}" }}"
      description: "CPU usage is above 85% for more than 30 minutes on {{ "{{ $labels.instance }}" }}"

  # High memory usage alert. The Proxmox hypervisors (node005/node006) run VMs
  # that pre-allocate RAM, so they sit near-full by design; they get a higher
  # 95% bar in the companion rule below, and pihole gets its own 95% rule too.
  # All other hosts alert at 85%.
  - alert: HighMemoryUsage
    expr: (node_memory_MemTotal_bytes{instance!~"node00[56].home|pihole.home"} - node_memory_MemAvailable_bytes{instance!~"node00[56].home|pihole.home"}) / node_memory_MemTotal_bytes{instance!~"node00[56].home|pihole.home"} * 100 > 85
    for: 5m
    labels:
      severity: warning
    annotations:
      summary: "High memory usage on {{ "{{ $labels.instance }}" }}"
      description: "Memory usage is above 85% for more than 5 minutes on {{ "{{ $labels.instance }}" }}"

  # Hypervisor memory: node005/node006 run near-full by design, so only alert
  # them at 95% — real host-memory exhaustion, not normal VM allocation.
  - alert: HighMemoryUsageHypervisor
    expr: (node_memory_MemTotal_bytes{instance=~"node00[56].home"} - node_memory_MemAvailable_bytes{instance=~"node00[56].home"}) / node_memory_MemTotal_bytes{instance=~"node00[56].home"} * 100 > 95
    for: 5m
    labels:
      severity: warning
    annotations:
      summary: "High memory usage on hypervisor {{ "{{ $labels.instance }}" }}"
      description: "Memory usage is above 95% for more than 5 minutes on hypervisor {{ "{{ $labels.instance }}" }}"

  # pihole: ~925 MiB with no swap, and it averages ~84% non-reclaimable use
  # (peak 88.5%, 7d to 2026-10-25), so 85% fired constantly. NOTE: with no swap,
  # 95% leaves little warning before the OOM killer takes FTL.
  - alert: HighMemoryUsagePihole
    expr: (node_memory_MemTotal_bytes{instance="pihole.home"} - node_memory_MemAvailable_bytes{instance="pihole.home"}) / node_memory_MemTotal_bytes{instance="pihole.home"} * 100 > 95
    for: 5m
    labels:
      severity: warning
    annotations:
      summary: "High memory usage on {{ "{{ $labels.instance }}" }}"
      description: "Memory usage is above 95% for more than 5 minutes on {{ "{{ $labels.instance }}" }}"

  # Disk space: critical near-full, plus a rate-based warning for steady fills.
  # There is deliberately no static warning tier below 90: a fixed percentage on
  # a 64TB media pool nags without saying anything actionable, and DiskWillFillSoon
  # already catches the case that matters (actually heading for zero).
  # Uses avail_bytes (what df/apps actually see, excludes root-reserved blocks)
  # and ignores ephemeral filesystems (tmpfs/overlay/etc).
  - alert: HighDiskUsage
    expr: (1 - node_filesystem_avail_bytes{fstype!~"tmpfs|overlay|squashfs|ramfs|fuse.*"} / node_filesystem_size_bytes{fstype!~"tmpfs|overlay|squashfs|ramfs|fuse.*"}) * 100 > 90
    for: 5m
    labels:
      severity: critical
    annotations:
      summary: "Disk over 90% on {{ "{{ $labels.instance }}" }} ({{ "{{ $labels.mountpoint }}" }})"
      description: "{{ "{{ $labels.mountpoint }}" }} on {{ "{{ $labels.instance }}" }} is {{ "{{ $value }}" }}% used - risk of service failure."

  # Catch steady fills (e.g. growing journals/logs) before they hit the threshold.
  - alert: DiskWillFillSoon
    expr: |
      predict_linear(node_filesystem_avail_bytes{fstype!~"tmpfs|overlay|squashfs|ramfs|fuse.*"}[6h], 24 * 3600) < 0
      and
      (1 - node_filesystem_avail_bytes{fstype!~"tmpfs|overlay|squashfs|ramfs|fuse.*"} / node_filesystem_size_bytes{fstype!~"tmpfs|overlay|squashfs|ramfs|fuse.*"}) * 100 > 60
    for: 30m
    labels:
      severity: warning
    annotations:
      summary: "Disk filling on {{ "{{ $labels.instance }}" }} ({{ "{{ $labels.mountpoint }}" }})"
      description: "{{ "{{ $labels.mountpoint }}" }} on {{ "{{ $labels.instance }}" }} is projected to run out of space within 24h at the current rate."

  # Service down alert (excluding all blackbox probes)
  - alert: ServiceDown
    expr: up{job!~"blackbox-.*"} == 0
    for: 5m
    labels:
      severity: critical
    annotations:
      summary: "Service {{ "{{ $labels.job }}" }} is down"
      description: "Service {{ "{{ $labels.job }}" }} on {{ "{{ $labels.instance }}" }} has been down for more than 5 minutes"

  # Any systemd unit in the failed state. Catches breakage that up==0 can't see
  # because the thing isn't a scrape target — crash-looping docker services (the
  # GitHub runners), agentbox lanes, promtail, etc. Needs node-exporter's
  # systemd collector (enabled fleet-wide).
  - alert: SystemdUnitFailed
    expr: node_systemd_unit_state{state="failed"} == 1
    for: 5m
    labels:
      severity: warning
    annotations:
      summary: "systemd unit {{ "{{ $labels.name }}" }} failed on {{ "{{ $labels.instance }}" }}"
      description: "{{ "{{ $labels.name }}" }} has been in the failed state for 5m on {{ "{{ $labels.instance }}" }}"

  # A unit stuck in `activating` is a restart loop, and SystemdUnitFailed above
  # cannot see it: a unit with Restart=always never settles into `failed`. This
  # is how comfyui and frigate crash-looped 128109 times on ocean without one
  # alert.
  #
  # NOTE: a oneshot sits in `activating` for its ENTIRE run, so this window has
  # to clear the longest legitimate run on the fleet or it pages on healthy
  # work. audible-download took 1h34m on 2026-09-02, and the agentbox lanes are
  # unbounded by nature, so 30m was wrong and even 2h is tight. 6h costs nothing
  # in detection: a genuinely wedged unit stays activating for days (comfyui sat
  # there for months). Raise it again if a legitimate run ever trips this.
  - alert: SystemdUnitStuckActivating
    expr: node_systemd_unit_state{state="activating"} == 1
    for: 6h
    labels:
      severity: warning
    annotations:
      summary: "systemd unit {{ "{{ $labels.name }}" }} stuck activating on {{ "{{ $labels.instance }}" }}"
      description: "{{ "{{ $labels.name }}" }} has been activating for 30m on {{ "{{ $labels.instance }}" }}, which means it is failing and restarting rather than starting"

  # A compose project whose image refresh failed is a failed docker-refresh@
  # instance, so SystemdUnitFailed above already carries it. The two rules here
  # cover only what unit state cannot say: that a timer stopped firing.
  #
  # Weekly cadence, so 10 days means at least one run was missed entirely. The
  # `> 0` arm excludes timers that have never fired, which report 0 rather than
  # a stale timestamp and are caught separately below.
  - alert: DockerRefreshStale
    expr: >
      (node_systemd_timer_last_trigger_seconds{name=~"docker-refresh@.*"} > 0)
       and (time() - node_systemd_timer_last_trigger_seconds{name=~"docker-refresh@.*"} > 864000)
    for: 1h
    labels:
      severity: warning
    annotations:
      summary: "image refresh stale for {{ "{{ $labels.name }}" }} on {{ "{{ $labels.instance }}" }}"
      description: "{{ "{{ $labels.name }}" }} has not fired in over 10 days on {{ "{{ $labels.instance }}" }}, so that project is not being refreshed. Note a timer that IS firing proves only cadence, not work: a stopped project is skipped with a clean exit, so check the journal before concluding the image is current"

  # A timer that has never fired reports 0 forever, and the rule above cannot
  # see it. A freshly enabled instance legitimately reads 0 until its first
  # scheduled day (dns02 is on Wed, everything else on Sun), so this has to wait
  # out a full cadence plus a day before calling it broken.
  #
  # NOTE: that 8 days lives in the query, not in `for:`. `for: 8d` needs 8
  # continuous days of in-memory pending state, and prometheus here restarted 23
  # times in the last 30 days (changes(process_start_time_seconds[30d]) = 23,
  # longest unbroken stretch 13.3d), so a `for:` that long is reset before it
  # ever fires. This PR makes that worse, not better: prometheus now has its own
  # docker-refresh@prometheus timer, so an upstream image move recreates the
  # evaluator. Reading the window from TSDB survives every restart.
  #
  # The count ratio is the "has existed long enough" guard, replacing what `for:`
  # used to do. It is a ratio, so it holds at any scrape interval, and it works
  # out to hours of series age: a fully covered window scores 8d/1h = 192, and
  # 191.95 measured on a live series.
  #
  # NOTE: this threshold must sit ABOVE the worst-case healthy first run, or it
  # pages for every new instance instead of catching broken ones. A timer
  # enabled just after its window closes (Sun 14:00) waits until the next Sun
  # 08:00 plus up to 6h of RandomizedDelaySec, so 6.75d to 7.00d is normal and
  # silent. 185 fires at 7.71d, which clears that by 0.71d and still tolerates
  # ~3.6% scrape gaps. 150 would have fired at 6.25d, i.e. before a healthy
  # timer's first run, and this deploy creates ~60-80 fresh instances at once.
  - alert: DockerRefreshNeverRan
    expr: >
      (max_over_time(node_systemd_timer_last_trigger_seconds{name=~"docker-refresh@.*"}[8d]) == 0)
       and
      (count_over_time(node_systemd_timer_last_trigger_seconds{name=~"docker-refresh@.*"}[8d])
        / count_over_time(node_systemd_timer_last_trigger_seconds{name=~"docker-refresh@.*"}[1h]) > 185)
    for: 1h
    labels:
      severity: warning
    annotations:
      summary: "image refresh never ran for {{ "{{ $labels.name }}" }} on {{ "{{ $labels.instance }}" }}"
      description: "{{ "{{ $labels.name }}" }} on {{ "{{ $labels.instance }}" }} has been enabled for over 8 days without firing once, so that project has never been refreshed"

  # Both rules above are plain vector selectors, so a host with zero
  # docker-refresh@ timers produces zero series and cannot alert on anything.
  # That is the dangerous state, not a stale one: node_exporter.yaml deletes the
  # old sweep units before it enables the new instances, so an apply that dies in
  # between leaves a host with nothing refreshing and nothing to be stale. It
  # also removes the old docker_refresh.prom heartbeat, so the previous
  # host-level signal is gone rather than left behind to fire.
  #
  # Any host running docker is expected to carry at least one instance. 2h rides
  # out the rollout window, where a host still on the old single sweep has no
  # docker-refresh@ series yet.
  - alert: DockerRefreshTimersMissing
    expr: >
      count by (instance) (node_systemd_unit_state{name="docker.service",state="active"} == 1)
       unless
      count by (instance) (node_systemd_timer_last_trigger_seconds{name=~"docker-refresh@.*"})
    for: 2h
    labels:
      severity: warning
    annotations:
      summary: "no image refresh timers on {{ "{{ $labels.instance }}" }}"
      description: "{{ "{{ $labels.instance }}" }} runs docker but has no docker-refresh@ timer at all, so nothing there is tracking upstream images and the staleness rules have no series to fire on"

  # Kometa has not completed a clean run in two days. It runs nightly, its
  # container reports healthy while doing nothing, and its stdout is silent, so
  # before this alert existed the service went 8+ months without a successful
  # run and nothing anywhere said so. kometa_last_success_timestamp_seconds is 0
  # when no log on disk shows a clean run, which the 30d guard below treats as
  # firing rather than as "brand new".
  # `unless in_progress` because these metrics describe the last COMPLETED run.
  # A long catch-up run would otherwise be alerted about for its entire
  # duration, on the strength of the very failure it is in the middle of fixing.
  #
  # NOTE: the absent() arm is not belt-and-braces, it is the arm that would have
  # caught the real failure. Both arms above need the series to exist, and a
  # single malformed line makes node_exporter reject the entire kometa.prom, so
  # every kometa_* series disappears at once and this rule goes quiet at exactly
  # the moment it has something to say. That is what a bad `grep -c ... || echo 0`
  # in kometa-metrics.sh did. An absent collector is itself the alertable state.
  - alert: KometaNotRunning
    expr: >
      (absent(kometa_last_success_timestamp_seconds)
       or (kometa_last_success_timestamp_seconds == 0)
       or (time() - kometa_last_success_timestamp_seconds > 172800))
      unless (kometa_run_in_progress == 1)
    for: 1h
    labels:
      severity: warning
    annotations:
      summary: "Kometa has not had a clean run in over 48h"
      description: "No Kometa run without a CRITICAL in 48h, or no kometa_* metrics at all. Check `scripts/loki.sh` for job=kometa, or /data01/services/kometa/config/logs/meta.log. If the series are missing rather than stale, check that /data01/services/node-exporter/text_files/kometa.prom is valid exposition -- one bad line drops the whole file. Collections and overlays are not being updated."

  # A run that finishes instantly did nothing. The original 8-month outage
  # looked exactly like this every night: Run Time 0:00:00, no crash visible
  # from outside, nothing updated.
  - alert: KometaRunDidNothing
    expr: >
      (kometa_last_run_failed == 1 and kometa_last_run_duration_seconds < 60)
      unless (kometa_run_in_progress == 1)
    for: 2h
    labels:
      severity: warning
    annotations:
      summary: "Kometa's last run failed after {{ "{{ $value }}" }}s"
      description: "Kometa aborted early rather than doing work. A config or Plex-connection error aborts in seconds and still prints a run summary."

  # Nothing has been written to the shared memory in 7 days. The store stays
  # up, the probe stays green, and the hooks fail silent by design, so without
  # this the only symptom is agents quietly getting dumber. This is the alert
  # that would have caught six weeks of captures going nowhere.
  - alert: Mem0CaptureStalled
    expr: mem0_newest_memory_age_seconds > 604800
    for: 30m
    labels:
      severity: warning
    annotations:
      summary: "mem0 has not stored a memory in {{ "{{ $value | humanizeDuration }}" }}"
      description: "The newest memory in the shared store is over 7d old. Either nothing is writing (check the laptop's ssh forward and ~/.claude/hooks/mem0-capture.sh) or writes are failing silently."

  # Writes are being attempted and rejected. CaptureStalled above eventually
  # catches this too, but it measures staleness, so it cannot tell "writes are
  # broken" from "nobody worked today" and has to wait 48h to be sure. This
  # fires in 15m and cannot false-positive on a quiet homelab: no requests
  # means no series, and no series means no alert.
  #
  # Written after extraction ran out of OpenAI credit and every add returned
  # 502 for 21 hours. Nothing caught it. Embeddings are local, so search stayed
  # fast, /docs stayed 200 and the container healthcheck stayed green the whole
  # time; the only real symptom was memories quietly not appearing. The 502s
  # were already in mem0_requests_recent that entire time. Nothing looked.
  - alert: Mem0WritesFailing
    expr: sum(mem0_requests_recent{path="/memories", status=~"5.."}) > 0
    for: 15m
    labels:
      severity: warning
    annotations:
      summary: "mem0 is rejecting writes: {{ "{{ $value }}" }} 5xx on /memories in the last window"
      description: "Adds are failing while reads stay healthy, because the embedder is local and only extraction leaves the network. Check the LLM provider first (credit, quota, outage) via `docker logs mem0 | grep -i 'LLM extraction failed'`. Captures are queued in ~/.claude/.cache/mem0-outbox.jsonl on the laptop and replay at the next session start, so nothing is lost while this is open."

  # The extraction provider is refusing or unreachable. Mem0WritesFailing sees
  # the same outage, but only once writes are being attempted and rejected: no
  # sessions means no writes, no 5xx and no alert, so the outage is discovered
  # by sitting down to work. This probe runs regardless of usage.
  #
  # -1 means the probe ran and failed, which is the credit-exhaustion case
  # (/v1/models kept returning 200 throughout that outage; only generating a
  # token surfaces insufficient_quota). Absent means it could not run at all,
  # so absent() is deliberately not alerted on here -- Mem0MetricsStale covers
  # a dead collector.
  - alert: Mem0ExtractionProviderDown
    expr: mem0_llm_probe_seconds == -1
    for: 10m
    labels:
      severity: warning
    annotations:
      summary: "mem0's extraction provider is not answering"
      description: "A 1-token completion against MEM0_LLM_BASE_URL failed. Writes will 502 while reads stay perfectly healthy, because the embedder is local and only extraction leaves the network. Check credit or quota first: `docker logs mem0 | grep -i 'LLM extraction failed'`. Captures queue in ~/.claude/.cache/mem0-outbox.jsonl and replay at the next session start, so nothing is lost while this is open."

  # Search slower than the recall hook's own timeout. Past this line the hook
  # gives up and injects nothing, with no error anywhere: sessions just start
  # without memory. Both real regressions here (a 30-thread pool on 2 cores,
  # then cpuset pinning onto a core a transcode owned) looked exactly like this.
  - alert: Mem0SearchSlow
    expr: mem0_request_latency_ms{path="/search",quantile="0.95"} > 6000
    for: 15m
    labels:
      severity: warning
    annotations:
      summary: "mem0 search p95 is {{ "{{ $value }}" }}ms, past the recall hook's 6s budget"
      description: "Recall is timing out and failing silent. Check mem0_embed_probe_seconds first; the embedder degrades rather than dies."

  # The collector itself stopped, which makes every other mem0 panel a museum.
  - alert: Mem0MetricsStale
    expr: time() - mem0_metrics_last_success_timestamp_seconds > 900
    for: 15m
    labels:
      severity: warning
    annotations:
      summary: "mem0 metrics are stale on {{ "{{ $labels.instance }}" }}"
      description: "mem0-metrics.timer has not published in 15m; the mem0 dashboard is showing the past."

  # Emporia's cloud API is unofficial, so an auth or schema change breaks it
  # quietly. The gauge starts at 0, so a container that never logs in fires too;
  # absent() covers the exporter being down entirely.
  - alert: EmporiaExporterStale
    expr: >
      absent(emporia_exporter_last_success_timestamp_seconds)
      or (time() - emporia_exporter_last_success_timestamp_seconds > 900)
    for: 15m
    labels:
      severity: warning
    annotations:
      summary: "Emporia plug power has not updated in 15m"
      description: "No poll where every plug returned a reading. emporia_up shows which plug; `docker logs emporia-exporter` on ocean shows login or API errors. The Power dashboard is missing desk/homelab draw."

  # tdarr_up is 0 when the exporter runs but cannot read Tdarr; absent()
  # covers the exporter itself being down.
  - alert: TdarrExporterDown
    expr: >
      absent(tdarr_up) or tdarr_up == 0
    for: 15m
    labels:
      severity: warning
    annotations:
      summary: "Tdarr metrics have not been readable for 15m"
      description: "tdarr-exporter on ocean cannot read Tdarr's API (or is down). `journalctl -u tdarr-exporter` and `docker logs tdarr-exporter` on ocean show why; the Tdarr dashboard is showing the past."

  # A homelab service that exposes no metrics failed its blackbox probe. Keyed
  # on the category label, not a hostname, so anything added to that target
  # group inherits the alert instead of shipping unwatched.
  - alert: HomelabServiceProbeDown
    expr: probe_success{category="homelab_services"} == 0
    for: 10m
    labels:
      severity: warning
    annotations:
      summary: "{{ "{{ $labels.instance }}" }} is failing its HTTP probe"
      description: "{{ "{{ $labels.instance }}" }} has not answered a blackbox probe for 10 minutes"

  # Plex unreachable from plex-exporter (exporter is scraping but Plex isn't
  # responding). Catches OOM/crash loops the generic ServiceDown alert misses
  # because the exporter itself stays up.
  - alert: PlexDown
    expr: plex_up == 0
    for: 5m
    labels:
      severity: critical
    annotations:
      summary: "Plex is unreachable from plex-exporter on {{ "{{ $labels.instance }}" }}"
      description: "plex_up has been 0 for more than 5 minutes on {{ "{{ $labels.instance }}" }} — Plex is down or in a restart loop"

  # WAN path to Plex is degraded — TCP/443 to the Plex API (plex.tv) failing
  # or losing >15%. Excludes 1.1.1.1:443 (control), so this fires only when
  # Plex's network specifically is bad, not when the entire internet is bad.
  - alert: PlexPathDegraded
    expr: |
      probe_success{job="blackbox-tcp-plex", instance!="1.1.1.1:443"} == 0
      or
      (1 - avg_over_time(probe_success{job="blackbox-tcp-plex", instance!="1.1.1.1:443"}[30m])) > 0.15
    for: 10m
    labels:
      severity: critical
    annotations:
      summary: "Plex WAN path degraded ({{ "{{ $labels.instance }}" }})"
      description: "TCP/443 probe to {{ "{{ $labels.instance }}" }} failing or losing >15% over 30m, for 10m. Open the WAN Path Diagnosis dashboard to see which hop."

  # General internet WAN path degraded — both Cloudflare and Google anchors
  # losing >5%. Distinguishes 'internet bad' from 'specifically Plex bad'.
  - alert: WANInternetDegraded
    expr: |
      (1 - avg_over_time(probe_success{job="blackbox-icmp", instance=~"1\\.1\\.1\\.1|8\\.8\\.8\\.8"}[10m])) > 0.15
    for: 10m
    labels:
      severity: warning
    annotations:
      summary: "WAN internet path degraded ({{ "{{ $labels.instance }}" }})"
      description: "ICMP loss to {{ "{{ $labels.instance }}" }} >15% over 10m, for 10m — general internet anchor unhealthy."

  # ConntrackTablePressure deferred — unpoller is not exposing metrics on
  # this gateway (service not running on ocean / endpoint returns empty).
  # When unpoller is restored or replaced, add a rule using the actual
  # conntrack_used / conntrack_max metric names.

  # GPU temperature alert (if NVIDIA GPU is present)
  - alert: HighGpuTemperature
    expr: nvidia_gpu_temperature_celsius > 85
    for: 10m
    labels:
      severity: warning
    annotations:
      summary: "High GPU temperature on {{ "{{ $labels.instance }}" }}"
      description: "GPU temperature is {{ "{{ $value }}" }}°C on {{ "{{ $labels.instance }}" }}"

- name: smart_alerts
  rules:
  # SMART health alert. smartctl_exporter exports smartctl_device_smart_status
  # (1 = PASSED); the rule used to read smart_device_health_ok, which it has never
  # exported, so this critical alert matched nothing on any host. Joined to
  # disk_wwn_info like the sector alerts below so the receiver files the
  # [replace] issue under a stable by-id name.
  # NOTE: the `or` keeps disks with no wwn link (6 of 18 on 2026-10-15) under
  # their kernel name. The join alone silently drops them, and a health alert
  # that skips a third of the disks is the bug this rule just had.
  - alert: SmartDeviceUnhealthy
    expr: |
      label_replace(
        label_replace(
          (
            smartctl_device_smart_status
              * on(instance, device) group_left(wwn, serial) disk_wwn_info
          ) != 1,
          "kernel_device", "$1", "device", "(.*)"
        ),
        "device", "$1", "wwn", "(.*)"
      )
      or
      (smartctl_device_smart_status unless on(instance, device) disk_wwn_info) != 1
    for: 0m
    labels:
      severity: critical
      remediation: manual
    annotations:
      summary: "SMART health check failed for {{ "{{ $labels.device }}" }}"
      description: "Drive {{ "{{ $labels.device }}" }} on {{ "{{ $labels.instance }}" }} has failed SMART health check"

- name: zfs_alerts
  rules:
  # Pool not ONLINE. SMART can still report PASSED while ZFS sees a device
  # faulted, so this is the alert that actually catches a degraded pool.
  - alert: ZpoolDegraded
    expr: zpool_health > 0
    for: 5m
    labels:
      severity: critical
      remediation: manual
    annotations:
      summary: "ZFS pool {{ "{{ $labels.pool }}" }} is not healthy ({{ "{{ $labels.instance }}" }})"
      description: "zpool_health={{ "{{ $value }}" }} (1=DEGRADED, 2=FAULTED) for {{ "{{ $labels.pool }}" }} on {{ "{{ $labels.instance }}" }}. Check `zpool status`. Recovery is a hand-run, never-automated drive replacement: follow the runbook."
      runbook_url: "https://github.com/bluefishforsale/homelab/blob/master/docs/operations/zfs-data01-disk-replacement-runbook.md"

  # Per-device read/write/cksum errors accumulating. `for` is long to ride out
  # transient blips during a resilver.
  - alert: ZpoolDeviceErrors
    expr: zpool_device_errors > 0
    for: 15m
    labels:
      severity: warning
      remediation: manual
    annotations:
      summary: "ZFS device {{ "{{ $labels.device }}" }} has {{ "{{ $labels.type }}" }} errors ({{ "{{ $labels.pool }}" }})"
      description: "{{ "{{ $value }}" }} {{ "{{ $labels.type }}" }} errors on {{ "{{ $labels.device }}" }} in pool {{ "{{ $labels.pool }}" }} on {{ "{{ $labels.instance }}" }}. A drive is likely failing; see the disk-replacement runbook."
      runbook_url: "https://github.com/bluefishforsale/homelab/blob/master/docs/operations/zfs-data01-disk-replacement-runbook.md"

  # Informational: a resilver/scrub is running (visibility, not paging).
  - alert: ZpoolResilverActive
    expr: zpool_resilver_active > 0
    for: 15m
    labels:
      severity: info
    annotations:
      summary: "ZFS pool {{ "{{ $labels.pool }}" }} is resilvering/scrubbing ({{ "{{ $labels.instance }}" }})"
      description: "A scan is in progress on {{ "{{ $labels.pool }}" }}. Avoid unnecessary drive operations until it completes."

- name: disk_wear_alerts
  rules:
  # Leading indicators SMART's binary health misses (it reports PASSED even at
  # 65k reallocated sectors). Alert on the raw counts so a drive pages BEFORE
  # ZFS faults it. Only clean-count attributes are used (Seagate packs
  # Raw_Read_Error_Rate / Seek_Error_Rate, so those are deliberately excluded).

  # Pending sectors = unreadable RIGHT NOW, about to reallocate or throw a read
  # error. Strongest "this drive is actively failing" signal; acute during a
  # resilver.
  - alert: DiskPendingSectors
    expr: |
      label_replace(
        label_replace(
          (
            smartctl_device_attribute{attribute_name="Current_Pending_Sector",attribute_value_type="raw"}
              * on(instance, device) group_left(wwn, serial) disk_wwn_info
          ) > 0,
          "kernel_device", "$1", "device", "(.*)"
        ),
        "device", "$1", "wwn", "(.*)"
      )
    for: 30m
    labels:
      severity: warning
      remediation: manual
    annotations:
      summary: "{{ "{{ $labels.device }}" }} has {{ "{{ $value }}" }} pending (unreadable) sectors ({{ "{{ $labels.instance }}" }})"
      description: "Current_Pending_Sector={{ "{{ $value }}" }} on {{ "{{ $labels.device }}" }} — sectors unreadable now. The drive is developing bad sectors; plan a replacement (see the disk-replacement runbook)."

  # Heavy cumulative reallocation. The drive is coping (remapped to spares) but
  # this is real wear; at these counts it should be scheduled for replacement.
  - alert: DiskReallocatedSectorsHigh
    expr: |
      label_replace(
        label_replace(
          (
            smartctl_device_attribute{attribute_name="Reallocated_Sector_Ct",attribute_value_type="raw"}
              * on(instance, device) group_left(wwn, serial) disk_wwn_info
          ) > 1000,
          "kernel_device", "$1", "device", "(.*)"
        ),
        "device", "$1", "wwn", "(.*)"
      )
    for: 1h
    labels:
      severity: warning
      remediation: manual
    annotations:
      summary: "{{ "{{ $labels.device }}" }} has {{ "{{ $value }}" }} reallocated sectors ({{ "{{ $labels.instance }}" }})"
      description: "Reallocated_Sector_Ct={{ "{{ $value }}" }} on {{ "{{ $labels.device }}" }}. SMART may still report PASSED; this is heavy wear — schedule replacement."

- name: memory_alerts
  rules:
  # ECC-corrected memory errors. node_exporter's edac collector already exports
  # these on the bare-metal hosts; before this rule nothing alerted, so a failing
  # DIMM was only ever found by a hand-run ras-mc-ctl/EDAC check. Correctable =
  # the bit-flip WAS fixed, but a rising count means a DIMM is degrading.
  # remediation: manual -> ntfy the human, never the code lane (no PR swaps a DIMM).
  - alert: EccCorrectableErrors
    expr: increase(node_edac_correctable_errors_total[1h]) > 0
    for: 15m
    labels:
      severity: warning
      remediation: manual
    annotations:
      summary: "ECC correctable errors on {{ "{{ $labels.instance }}" }} (mc{{ "{{ $labels.controller }}" }})"
      description: "{{ "{{ $value }}" }} correctable ECC errors in the last hour on controller {{ "{{ $labels.controller }}" }} of {{ "{{ $labels.instance }}" }}. The error was corrected, but a rising count flags a failing DIMM; identify it (ras-mc-ctl / iDRAC) and schedule replacement."

  # Uncorrectable ECC = data the ECC could NOT fix. Imminent DIMM failure and a
  # real corruption risk (this is the class of fault we ruled out for the data01
  # checksum errors); page immediately.
  - alert: EccUncorrectableErrors
    expr: increase(node_edac_uncorrectable_errors_total[1h]) > 0
    for: 0m
    labels:
      severity: critical
      remediation: manual
    annotations:
      summary: "UNCORRECTABLE ECC errors on {{ "{{ $labels.instance }}" }} (mc{{ "{{ $labels.controller }}" }})"
      description: "{{ "{{ $value }}" }} uncorrectable ECC errors on controller {{ "{{ $labels.controller }}" }} of {{ "{{ $labels.instance }}" }}. ECC could not correct these; a DIMM is failing and data integrity is at risk. Replace the DIMM."

- name: backup_alerts
  rules:
  # The nightly DB backup writes homelab_db_backup_* to the node_exporter
  # textfile collector. Staleness catches a backup that silently stopped
  # running (timer dead, host down at 03:30, upload wedged); the value is
  # carried forward on failure so the age keeps growing until a clean run.
  - alert: DbBackupStale
    expr: time() - homelab_db_backup_last_success_timestamp_seconds > 129600
    for: 30m
    labels:
      severity: warning
    annotations:
      summary: "Homelab DB backup is stale ({{ "{{ $labels.instance }}" }})"
      description: "No fully-successful homelab database backup in over 36h. The nightly timer may be dead, the host down at 03:30, or the GCS upload wedged. Check `systemctl status db-backup.service` and the last db_backup.prom on {{ "{{ $labels.instance }}" }}."

  # A run that completed but with per-DB failures (a dump errored) - the tarball
  # is incomplete even if it uploaded.
  - alert: DbBackupFailing
    expr: homelab_db_backup_failed > 0
    for: 15m
    labels:
      severity: warning
    annotations:
      summary: "Homelab DB backup completed with {{ "{{ $value }}" }} failed database(s)"
      description: "The last backup run on {{ "{{ $labels.instance }}" }} failed to dump {{ "{{ $value }}" }} in-scope database(s); the tarball is incomplete. Check the db-backup.service journal for which."

  # The nightly restore test on harbor loads every backup into a throwaway
  # container. A 0 means that service's backup would not restore, or restored
  # an empty or (for the self-writing services) stale database.
  - alert: DbRestoreTestFailing
    expr: homelab_db_restore_test_ok == 0
    for: 15m
    labels:
      severity: warning
    annotations:
      summary: "DB backup for {{ "{{ $labels.service }}" }} failed its restore test"
      description: "The latest {{ "{{ $labels.service }}" }} backup did not restore cleanly into a throwaway container, or its newest record is missing or too old. Check `journalctl -u db-restore-test.service` on harbor for the FAIL line."

  - alert: DbRestoreTestStale
    expr: time() - homelab_db_restore_test_last_success_timestamp_seconds > 129600
    for: 30m
    labels:
      severity: warning
    annotations:
      summary: "DB restore test has not passed in 36h ({{ "{{ $labels.instance }}" }})"
      description: "No restore-test run has passed every backup in over 36h. The timer may be dead, harbor down at 06:00, or one service failing every night. Check `systemctl status db-restore-test.service` on harbor."

  # nzbget-prune writes its success time only on a run that read nzbget and
  # finished, so a dead timer or an nzbget it can't reach both show as age.
  - alert: NzbgetPruneStale
    expr: time() - nzbget_prune_last_success_timestamp_seconds > 172800
    for: 30m
    labels:
      severity: warning
    annotations:
      summary: "nzbget-prune has not succeeded in 2 days ({{ "{{ $labels.instance }}" }})"
      description: "Failed and stale downloads are piling up on harbor's scratch SSD and data01 again. Check `systemctl status nzbget-prune.service` and its journal on {{ "{{ $labels.instance }}" }}; it prunes nothing while nzbget's API is unreachable."

- name: sas_phy_alerts
  rules:
  # SAS transport counters are cumulative, so alert on the RATE of increase (a
  # static historical count from one bad moment must not page). Invalid dwords
  # climbing fast = a marginal cable / backplane lane / expander phy - the class
  # of physical-layer fault behind correlated ZFS checksum errors. remediation:
  # manual (reseat/replace the cable or drive caddy; no PR fixes a wire).
  - alert: SasPhyErrorsRising
    expr: increase(sas_phy_invalid_dword_total[1h]) + increase(sas_phy_running_disparity_error_total[1h]) > 1000
    for: 15m
    labels:
      severity: warning
      remediation: manual
    annotations:
      summary: "SAS phy {{ "{{ $labels.phy }}" }} accumulating link errors ({{ "{{ $labels.instance }}" }})"
      description: "{{ "{{ $value | humanize }}" }} invalid-dword/disparity errors in the last hour on SAS phy {{ "{{ $labels.phy }}" }} (sas_addr {{ "{{ $labels.sas_address }}" }}) of {{ "{{ $labels.instance }}" }}. A cable, backplane lane, or expander phy is degrading; reseat or replace it."

  # Loss-of-dword-sync / phy resets = the link is actually dropping and
  # re-syncing, more serious than dword errors. Any sustained increase pages.
  - alert: SasPhyLinkResync
    expr: increase(sas_phy_loss_of_dword_sync_total[1h]) + increase(sas_phy_reset_problem_total[1h]) > 10
    for: 15m
    labels:
      severity: warning
      remediation: manual
    annotations:
      summary: "SAS phy {{ "{{ $labels.phy }}" }} link is resetting/losing sync ({{ "{{ $labels.instance }}" }})"
      description: "{{ "{{ $value | humanize }}" }} loss-of-sync/reset events in the last hour on SAS phy {{ "{{ $labels.phy }}" }} of {{ "{{ $labels.instance }}" }}. The physical link is unstable; check the cable/backplane connection to that drive."

- name: ipmi_alerts
  rules:
  # In-band ipmi_exporter reads the Dell iDRAC BMC on node005/node006 (the only
  # [baremetal] hosts). The BMC applies each sensor's OWN thresholds and reports
  # a rolled-up state, so we alert on that state rather than hardcoding a temp/
  # RPM/voltage number the BMC already knows better than we do. All ipmi rules
  # are remediation: manual -> ntfy the human; no PR reseats a PSU or a DIMM.
  #
  # NOTE: "Entity Presence" sensors read state=2 on healthy R620/R720 chassis
  # (a freeipmi mapping quirk for backplane/riser presence bits), so every
  # sensor rule excludes that type or it would page on nominal hardware. The
  # chassis_*_fault_state metrics are likewise unreliable here (cooling/drive
  # fault bits read 1 on both healthy nodes), so we do NOT alert on them - the
  # per-sensor Fan/Drive-Slot states below are the trustworthy signal.
  - alert: IpmiExporterDown
    expr: ipmi_up == 0
    for: 10m
    labels:
      severity: warning
      remediation: manual
    annotations:
      summary: "IPMI/BMC unreachable on {{ "{{ $labels.instance }}" }}"
      description: "The in-band ipmi_exporter has been unable to read the BMC on {{ "{{ $labels.instance }}" }} for 10m (collector {{ "{{ $labels.collector }}" }}). Hardware health for this Dell host is now blind - check the exporter container and /dev/ipmi0."

  # A sensor the BMC reports as Critical (state=2): temp over the upper-critical
  # threshold, a fan stopped, a PSU lost AC/redundancy, a CPU/DIMM fault. This
  # is real hardware in trouble - page and get hands on it.
  - alert: IpmiSensorCritical
    expr: ipmi_sensor_state{type!="Entity Presence"} == 2
    for: 5m
    labels:
      severity: critical
      remediation: manual
    annotations:
      summary: "IPMI sensor CRITICAL: {{ "{{ $labels.name }}" }} ({{ "{{ $labels.type }}" }}) on {{ "{{ $labels.instance }}" }}"
      description: "BMC reports sensor '{{ "{{ $labels.name }}" }}' (type {{ "{{ $labels.type }}" }}) in CRITICAL state on {{ "{{ $labels.instance }}" }}. Current reading in the Dell Hardware (IPMI) dashboard. Check the iDRAC and the physical part (fan/PSU/DIMM/CPU)."

  # Non-critical / warning state (state=1): approaching a threshold. Longer for:
  # to ride out a brief thermal excursion under load.
  - alert: IpmiSensorWarning
    expr: ipmi_sensor_state{type!="Entity Presence"} == 1
    for: 15m
    labels:
      severity: warning
      remediation: manual
    annotations:
      summary: "IPMI sensor warning: {{ "{{ $labels.name }}" }} ({{ "{{ $labels.type }}" }}) on {{ "{{ $labels.instance }}" }}"
      description: "BMC reports sensor '{{ "{{ $labels.name }}" }}' (type {{ "{{ $labels.type }}" }}) in a non-critical warning state on {{ "{{ $labels.instance }}" }} for 15m. Approaching a threshold; check the Dell Hardware (IPMI) dashboard before it escalates."

- name: ups_alerts
  rules:
  # The three Back-UPS on node005's NUT server (nut_ups.yaml). upsmon on
  # node005/node006 does the shutting down; these only make it visible. All
  # three hang off one wall socket, so a real outage fires for all three.
  - alert: UpsOnBattery
    expr: network_ups_tools_ups_status{flag="OB"} == 1
    for: 30s
    labels:
      severity: critical
      remediation: manual
    annotations:
      summary: "UPS {{ "{{ $labels.ups }}" }} is on battery"
      description: "{{ "{{ $labels.ups }}" }} lost input power. upsmon shuts node005 and node006 down when any UPS reaches low battery (420s runtime). Check the wall socket and breaker."

  - alert: UpsLowBattery
    expr: network_ups_tools_ups_status{flag="LB"} == 1
    for: 0m
    labels:
      severity: critical
      remediation: manual
    annotations:
      summary: "UPS {{ "{{ $labels.ups }}" }} is at low battery"
      description: "{{ "{{ $labels.ups }}" }} reports LB (runtime under 420s). If it is also on battery, upsmon is shutting the hypervisors down now. If it is on-line, its battery is too weak to cover a shutdown: replace it."

  # Full-charge runtime creeping toward the shutdown threshold means an aging
  # battery: an outage would trigger shutdown within moments of starting.
  # NOTE: `on(ups)` is required. The status series carries a `flag` label the
  # runtime series lacks, so a bare `and` matches nothing and the rule is mute.
  - alert: UpsRuntimeNearShutdownThreshold
    expr: network_ups_tools_battery_runtime < 600 and on(ups) network_ups_tools_ups_status{flag="OL"} == 1
    for: 1h
    labels:
      severity: warning
      remediation: manual
    annotations:
      summary: "UPS {{ "{{ $labels.ups }}" }} has under 10 min runtime on-line"
      description: "{{ "{{ $labels.ups }}" }} would last {{ "{{ $value }}" }}s at current load and upsmon shuts down at 420s, so an outage starts the shutdown almost at once. Shed load from it or replace its battery."

  # Absence is the alertable state: if the exporter or NUT server is down, every
  # rule above goes quiet at the moment it matters.
  - alert: UpsMonitoringDown
    expr: up{job="nut"} == 0 or absent(up{job="nut"})
    for: 10m
    labels:
      severity: warning
      remediation: manual
    annotations:
      summary: "UPS monitoring down for {{ "{{ $labels.ups }}" }}"
      description: "Prometheus cannot read {{ "{{ $labels.ups }}" }} via nut-exporter on ocean:9197 -> node005:3493. Check `upsc -l` on node005, the nut-driver@ units, and the nut-exporter container. upsmon shutdown may still work; visibility does not."

- name: data01_worker_alerts
  rules:
  # [data01_workers] mount ocean's /data01 over NFS and keep service state on a
  # local disk over /data01/services (data01_worker.yaml). Worker list comes
  # from the inventory, so a new worker is covered by being in the group.
{% set data01_worker_re = groups['data01_workers'] | map('regex_replace', '$', '.home') | join('|') %}
  # Exporter up but no NFS /data01: the worker's media jobs have nothing to read.
  - alert: Data01WorkerNfsMissing
    expr: up{job="node_exporter",instance=~"{{ data01_worker_re }}"} == 1 unless on(instance) node_filesystem_size_bytes{mountpoint="/data01",fstype="nfs4"}
    for: 10m
    labels:
      severity: warning
      remediation: manual
    annotations:
      summary: "{{ "{{ $labels.instance }}" }} has no NFS /data01"
      description: "{{ "{{ $labels.instance }}" }} is up but ocean's /data01 is not mounted (nfs4). Check nfs-server on ocean and `findmnt /data01` on the worker; docker on the worker will not start without it."

  # The local state disk is gone: docker's sentinel guard keeps containers from
  # writing into ocean's /data01/services, so the worker's services are down.
  - alert: Data01WorkerStateDiskMissing
    expr: up{job="node_exporter",instance=~"{{ data01_worker_re }}"} == 1 unless on(instance) node_filesystem_size_bytes{mountpoint="/data01/services",fstype="ext4"}
    for: 5m
    labels:
      severity: critical
      remediation: manual
    annotations:
      summary: "{{ "{{ $labels.instance }}" }} lost its local /data01/services disk"
      description: "The local ext4 state disk is not mounted on {{ "{{ $labels.instance }}" }}. docker refuses to start (no .worker-local sentinel), so its services are down. Do NOT remove the guard; remount the disk."

  # A hard NFS mount waits instead of failing, so a sick export shows up as
  # retransmissions and stalled jobs, not errors.
  - alert: Data01WorkerNfsRetransmits
    expr: rate(node_nfs_rpc_retransmissions_total{instance=~"{{ data01_worker_re }}"}[10m]) > 0
    for: 10m
    labels:
      severity: warning
      remediation: manual
    annotations:
      summary: "NFS retransmits on {{ "{{ $labels.instance }}" }}"
      description: "{{ "{{ $labels.instance }}" }} has been retransmitting NFS RPCs to ocean for 10m ({{ "{{ $value | humanize }}" }}/s). Processes on the mount stall rather than fail; check ocean's load and nfsd."
