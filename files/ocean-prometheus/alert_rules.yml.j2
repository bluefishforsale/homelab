groups:
- name: basic_alerts
  rules:
  # High CPU usage alert
  - alert: HighCpuUsage
    expr: 100 - (avg by(instance) (rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100) > 80
    for: 5m
    labels:
      severity: warning
    annotations:
      summary: "High CPU usage on {{ "{{ $labels.instance }}" }}"
      description: "CPU usage is above 80% for more than 5 minutes on {{ "{{ $labels.instance }}" }}"

  # High memory usage alert. The Proxmox hypervisors (node005/node006) run VMs
  # that pre-allocate RAM, so they sit near-full by design; they get a higher
  # 95% bar in the companion rule below. All other hosts alert at 85%.
  - alert: HighMemoryUsage
    expr: (node_memory_MemTotal_bytes{instance!~"node00[56].home"} - node_memory_MemAvailable_bytes{instance!~"node00[56].home"}) / node_memory_MemTotal_bytes{instance!~"node00[56].home"} * 100 > 85
    for: 5m
    labels:
      severity: warning
    annotations:
      summary: "High memory usage on {{ "{{ $labels.instance }}" }}"
      description: "Memory usage is above 85% for more than 5 minutes on {{ "{{ $labels.instance }}" }}"

  # Hypervisor memory: node005/node006 run near-full by design, so only alert
  # them at 95% — real host-memory exhaustion, not normal VM allocation.
  - alert: HighMemoryUsageHypervisor
    expr: (node_memory_MemTotal_bytes{instance=~"node00[56].home"} - node_memory_MemAvailable_bytes{instance=~"node00[56].home"}) / node_memory_MemTotal_bytes{instance=~"node00[56].home"} * 100 > 95
    for: 5m
    labels:
      severity: warning
    annotations:
      summary: "High memory usage on hypervisor {{ "{{ $labels.instance }}" }}"
      description: "Memory usage is above 95% for more than 5 minutes on hypervisor {{ "{{ $labels.instance }}" }}"

  # Disk space: critical near-full, plus a rate-based warning for steady fills.
  # There is deliberately no static warning tier below 90: a fixed percentage on
  # a 64TB media pool nags without saying anything actionable, and DiskWillFillSoon
  # already catches the case that matters (actually heading for zero).
  # Uses avail_bytes (what df/apps actually see, excludes root-reserved blocks)
  # and ignores ephemeral filesystems (tmpfs/overlay/etc).
  - alert: HighDiskUsage
    expr: (1 - node_filesystem_avail_bytes{fstype!~"tmpfs|overlay|squashfs|ramfs|fuse.*"} / node_filesystem_size_bytes{fstype!~"tmpfs|overlay|squashfs|ramfs|fuse.*"}) * 100 > 90
    for: 5m
    labels:
      severity: critical
    annotations:
      summary: "Disk over 90% on {{ "{{ $labels.instance }}" }} ({{ "{{ $labels.mountpoint }}" }})"
      description: "{{ "{{ $labels.mountpoint }}" }} on {{ "{{ $labels.instance }}" }} is {{ "{{ $value }}" }}% used - risk of service failure."

  # Catch steady fills (e.g. growing journals/logs) before they hit the threshold.
  - alert: DiskWillFillSoon
    expr: |
      predict_linear(node_filesystem_avail_bytes{fstype!~"tmpfs|overlay|squashfs|ramfs|fuse.*"}[6h], 24 * 3600) < 0
      and
      (1 - node_filesystem_avail_bytes{fstype!~"tmpfs|overlay|squashfs|ramfs|fuse.*"} / node_filesystem_size_bytes{fstype!~"tmpfs|overlay|squashfs|ramfs|fuse.*"}) * 100 > 60
    for: 30m
    labels:
      severity: warning
    annotations:
      summary: "Disk filling on {{ "{{ $labels.instance }}" }} ({{ "{{ $labels.mountpoint }}" }})"
      description: "{{ "{{ $labels.mountpoint }}" }} on {{ "{{ $labels.instance }}" }} is projected to run out of space within 24h at the current rate."

  # Service down alert (excluding all blackbox probes)
  - alert: ServiceDown
    expr: up{job!~"blackbox-.*"} == 0
    for: 5m
    labels:
      severity: critical
    annotations:
      summary: "Service {{ "{{ $labels.job }}" }} is down"
      description: "Service {{ "{{ $labels.job }}" }} on {{ "{{ $labels.instance }}" }} has been down for more than 5 minutes"

  # Any systemd unit in the failed state. Catches breakage that up==0 can't see
  # because the thing isn't a scrape target — crash-looping docker services (the
  # GitHub runners), agentbox lanes, promtail, etc. Needs node-exporter's
  # systemd collector (enabled fleet-wide).
  - alert: SystemdUnitFailed
    expr: node_systemd_unit_state{state="failed"} == 1
    for: 5m
    labels:
      severity: warning
    annotations:
      summary: "systemd unit {{ "{{ $labels.name }}" }} failed on {{ "{{ $labels.instance }}" }}"
      description: "{{ "{{ $labels.name }}" }} has been in the failed state for 5m on {{ "{{ $labels.instance }}" }}"

  # Kometa has not completed a clean run in two days. It runs nightly, its
  # container reports healthy while doing nothing, and its stdout is silent, so
  # before this alert existed the service went 8+ months without a successful
  # run and nothing anywhere said so. kometa_last_success_timestamp_seconds is 0
  # when no log on disk shows a clean run, which the 30d guard below treats as
  # firing rather than as "brand new".
  # `unless in_progress` because these metrics describe the last COMPLETED run.
  # A long catch-up run would otherwise be alerted about for its entire
  # duration, on the strength of the very failure it is in the middle of fixing.
  - alert: KometaNotRunning
    expr: >
      ((kometa_last_success_timestamp_seconds == 0)
       or (time() - kometa_last_success_timestamp_seconds > 172800))
      unless (kometa_run_in_progress == 1)
    for: 1h
    labels:
      severity: warning
    annotations:
      summary: "Kometa has not had a clean run in over 48h"
      description: "No Kometa run without a CRITICAL in 48h. Check `scripts/loki.sh` for job=kometa, or /data01/services/plex-meta-manager/config/logs/meta.log. Collections and overlays are not being updated."

  # A run that finishes instantly did nothing. The original 8-month outage
  # looked exactly like this every night: Run Time 0:00:00, no crash visible
  # from outside, nothing updated.
  - alert: KometaRunDidNothing
    expr: >
      (kometa_last_run_failed == 1 and kometa_last_run_duration_seconds < 60)
      unless (kometa_run_in_progress == 1)
    for: 2h
    labels:
      severity: warning
    annotations:
      summary: "Kometa's last run failed after {{ "{{ $value }}" }}s"
      description: "Kometa aborted early rather than doing work. A config or Plex-connection error aborts in seconds and still prints a run summary."

  # Nothing has been written to the shared memory in two days. The store stays
  # up, the probe stays green, and the hooks fail silent by design, so without
  # this the only symptom is agents quietly getting dumber. This is the alert
  # that would have caught six weeks of captures going nowhere.
  - alert: Mem0CaptureStalled
    expr: mem0_newest_memory_age_seconds > 172800
    for: 30m
    labels:
      severity: warning
    annotations:
      summary: "mem0 has not stored a memory in {{ "{{ $value | humanizeDuration }}" }}"
      description: "The newest memory in the shared store is over 48h old. Either nothing is writing (check the laptop's ssh forward and ~/.claude/hooks/mem0-capture.sh) or writes are failing silently."

  # Writes are being attempted and rejected. CaptureStalled above eventually
  # catches this too, but it measures staleness, so it cannot tell "writes are
  # broken" from "nobody worked today" and has to wait 48h to be sure. This
  # fires in 15m and cannot false-positive on a quiet homelab: no requests
  # means no series, and no series means no alert.
  #
  # Written after extraction ran out of OpenAI credit and every add returned
  # 502 for 21 hours. Nothing caught it. Embeddings are local, so search stayed
  # fast, /docs stayed 200 and the container healthcheck stayed green the whole
  # time; the only real symptom was memories quietly not appearing. The 502s
  # were already in mem0_requests_recent that entire time. Nothing looked.
  - alert: Mem0WritesFailing
    expr: sum(mem0_requests_recent{path="/memories", status=~"5.."}) > 0
    for: 15m
    labels:
      severity: warning
    annotations:
      summary: "mem0 is rejecting writes: {{ "{{ $value }}" }} 5xx on /memories in the last window"
      description: "Adds are failing while reads stay healthy, because the embedder is local and only extraction leaves the network. Check the LLM provider first (credit, quota, outage) via `docker logs mem0 | grep -i 'LLM extraction failed'`. Captures are queued in ~/.claude/.cache/mem0-outbox.jsonl on the laptop and replay at the next session start, so nothing is lost while this is open."

  # The extraction provider is refusing or unreachable. Mem0WritesFailing sees
  # the same outage, but only once writes are being attempted and rejected: no
  # sessions means no writes, no 5xx and no alert, so the outage is discovered
  # by sitting down to work. This probe runs regardless of usage.
  #
  # -1 means the probe ran and failed, which is the credit-exhaustion case
  # (/v1/models kept returning 200 throughout that outage; only generating a
  # token surfaces insufficient_quota). Absent means it could not run at all,
  # so absent() is deliberately not alerted on here -- Mem0MetricsStale covers
  # a dead collector.
  - alert: Mem0ExtractionProviderDown
    expr: mem0_llm_probe_seconds == -1
    for: 10m
    labels:
      severity: warning
    annotations:
      summary: "mem0's extraction provider is not answering"
      description: "A 1-token completion against MEM0_LLM_BASE_URL failed. Writes will 502 while reads stay perfectly healthy, because the embedder is local and only extraction leaves the network. Check credit or quota first: `docker logs mem0 | grep -i 'LLM extraction failed'`. Captures queue in ~/.claude/.cache/mem0-outbox.jsonl and replay at the next session start, so nothing is lost while this is open."

  # Search slower than the recall hook's own timeout. Past this line the hook
  # gives up and injects nothing, with no error anywhere: sessions just start
  # without memory. Both real regressions here (a 30-thread pool on 2 cores,
  # then cpuset pinning onto a core a transcode owned) looked exactly like this.
  - alert: Mem0SearchSlow
    expr: mem0_request_latency_ms{path="/search",quantile="0.95"} > 6000
    for: 15m
    labels:
      severity: warning
    annotations:
      summary: "mem0 search p95 is {{ "{{ $value }}" }}ms, past the recall hook's 6s budget"
      description: "Recall is timing out and failing silent. Check mem0_embed_probe_seconds first; the embedder degrades rather than dies."

  # The collector itself stopped, which makes every other mem0 panel a museum.
  - alert: Mem0MetricsStale
    expr: time() - mem0_metrics_last_success_timestamp_seconds > 900
    for: 15m
    labels:
      severity: warning
    annotations:
      summary: "mem0 metrics are stale on {{ "{{ $labels.instance }}" }}"
      description: "mem0-metrics.timer has not published in 15m; the mem0 dashboard is showing the past."

  # A homelab service that exposes no metrics failed its blackbox probe. Keyed
  # on the category label, not a hostname, so anything added to that target
  # group inherits the alert instead of shipping unwatched.
  - alert: HomelabServiceProbeDown
    expr: probe_success{category="homelab_services"} == 0
    for: 10m
    labels:
      severity: warning
    annotations:
      summary: "{{ "{{ $labels.instance }}" }} is failing its HTTP probe"
      description: "{{ "{{ $labels.instance }}" }} has not answered a blackbox probe for 10 minutes"

  # Plex unreachable from plex-exporter (exporter is scraping but Plex isn't
  # responding). Catches OOM/crash loops the generic ServiceDown alert misses
  # because the exporter itself stays up.
  - alert: PlexDown
    expr: plex_up == 0
    for: 5m
    labels:
      severity: critical
    annotations:
      summary: "Plex is unreachable from plex-exporter on {{ "{{ $labels.instance }}" }}"
      description: "plex_up has been 0 for more than 5 minutes on {{ "{{ $labels.instance }}" }} — Plex is down or in a restart loop"

  # WAN path to Plex is degraded — TCP/443 to the Plex API (plex.tv) failing
  # or losing >15%. Excludes 1.1.1.1:443 (control), so this fires only when
  # Plex's network specifically is bad, not when the entire internet is bad.
  - alert: PlexPathDegraded
    expr: |
      probe_success{job="blackbox-tcp-plex", instance!="1.1.1.1:443"} == 0
      or
      (1 - avg_over_time(probe_success{job="blackbox-tcp-plex", instance!="1.1.1.1:443"}[10m])) > 0.15
    for: 10m
    labels:
      severity: critical
    annotations:
      summary: "Plex WAN path degraded ({{ "{{ $labels.instance }}" }})"
      description: "TCP/443 probe to {{ "{{ $labels.instance }}" }} failing or losing >15% over 10m, for 10m. Open the WAN Path Diagnosis dashboard to see which hop."

  # General internet WAN path degraded — both Cloudflare and Google anchors
  # losing >5%. Distinguishes 'internet bad' from 'specifically Plex bad'.
  - alert: WANInternetDegraded
    expr: |
      (1 - avg_over_time(probe_success{job="blackbox-icmp", instance=~"1\\.1\\.1\\.1|8\\.8\\.8\\.8"}[10m])) > 0.15
    for: 10m
    labels:
      severity: warning
    annotations:
      summary: "WAN internet path degraded ({{ "{{ $labels.instance }}" }})"
      description: "ICMP loss to {{ "{{ $labels.instance }}" }} >15% over 10m, for 10m — general internet anchor unhealthy."

  # ConntrackTablePressure deferred — unpoller is not exposing metrics on
  # this gateway (service not running on ocean / endpoint returns empty).
  # When unpoller is restored or replaced, add a rule using the actual
  # conntrack_used / conntrack_max metric names.

  # GPU temperature alert (if NVIDIA GPU is present)
  - alert: HighGpuTemperature
    expr: nvidia_gpu_temperature_celsius > 85
    for: 10m
    labels:
      severity: warning
    annotations:
      summary: "High GPU temperature on {{ "{{ $labels.instance }}" }}"
      description: "GPU temperature is {{ "{{ $value }}" }}°C on {{ "{{ $labels.instance }}" }}"

- name: smart_alerts
  rules:
  # SMART health alert
  - alert: SmartDeviceUnhealthy
    expr: smart_device_health_ok != 1
    for: 0m
    labels:
      severity: critical
      remediation: manual
    annotations:
      summary: "SMART health check failed for {{ "{{ $labels.device }}" }}"
      description: "Drive {{ "{{ $labels.device }}" }} on {{ "{{ $labels.instance }}" }} has failed SMART health check"

- name: zfs_alerts
  rules:
  # Pool not ONLINE. SMART can still report PASSED while ZFS sees a device
  # faulted, so this is the alert that actually catches a degraded pool.
  - alert: ZpoolDegraded
    expr: zpool_health > 0
    for: 5m
    labels:
      severity: critical
      remediation: manual
    annotations:
      summary: "ZFS pool {{ "{{ $labels.pool }}" }} is not healthy ({{ "{{ $labels.instance }}" }})"
      description: "zpool_health={{ "{{ $value }}" }} (1=DEGRADED, 2=FAULTED) for {{ "{{ $labels.pool }}" }} on {{ "{{ $labels.instance }}" }}. Check `zpool status`. Recovery is a hand-run, never-automated drive replacement: follow the runbook."
      runbook_url: "https://github.com/bluefishforsale/homelab/blob/master/docs/operations/zfs-data01-disk-replacement-runbook.md"

  # Per-device read/write/cksum errors accumulating. `for` is long to ride out
  # transient blips during a resilver.
  - alert: ZpoolDeviceErrors
    expr: zpool_device_errors > 0
    for: 15m
    labels:
      severity: warning
      remediation: manual
    annotations:
      summary: "ZFS device {{ "{{ $labels.device }}" }} has {{ "{{ $labels.type }}" }} errors ({{ "{{ $labels.pool }}" }})"
      description: "{{ "{{ $value }}" }} {{ "{{ $labels.type }}" }} errors on {{ "{{ $labels.device }}" }} in pool {{ "{{ $labels.pool }}" }} on {{ "{{ $labels.instance }}" }}. A drive is likely failing; see the disk-replacement runbook."
      runbook_url: "https://github.com/bluefishforsale/homelab/blob/master/docs/operations/zfs-data01-disk-replacement-runbook.md"

  # Informational: a resilver/scrub is running (visibility, not paging).
  - alert: ZpoolResilverActive
    expr: zpool_resilver_active > 0
    for: 15m
    labels:
      severity: info
    annotations:
      summary: "ZFS pool {{ "{{ $labels.pool }}" }} is resilvering/scrubbing ({{ "{{ $labels.instance }}" }})"
      description: "A scan is in progress on {{ "{{ $labels.pool }}" }}. Avoid unnecessary drive operations until it completes."

- name: disk_wear_alerts
  rules:
  # Leading indicators SMART's binary health misses (it reports PASSED even at
  # 65k reallocated sectors). Alert on the raw counts so a drive pages BEFORE
  # ZFS faults it. Only clean-count attributes are used (Seagate packs
  # Raw_Read_Error_Rate / Seek_Error_Rate, so those are deliberately excluded).

  # Pending sectors = unreadable RIGHT NOW, about to reallocate or throw a read
  # error. Strongest "this drive is actively failing" signal; acute during a
  # resilver.
  - alert: DiskPendingSectors
    expr: smartctl_device_attribute{attribute_name="Current_Pending_Sector",attribute_value_type="raw"} > 0
    for: 30m
    labels:
      severity: warning
      remediation: manual
    annotations:
      summary: "{{ "{{ $labels.device }}" }} has {{ "{{ $value }}" }} pending (unreadable) sectors ({{ "{{ $labels.instance }}" }})"
      description: "Current_Pending_Sector={{ "{{ $value }}" }} on {{ "{{ $labels.device }}" }} — sectors unreadable now. The drive is developing bad sectors; plan a replacement (see the disk-replacement runbook)."

  # Heavy cumulative reallocation. The drive is coping (remapped to spares) but
  # this is real wear; at these counts it should be scheduled for replacement.
  - alert: DiskReallocatedSectorsHigh
    expr: smartctl_device_attribute{attribute_name="Reallocated_Sector_Ct",attribute_value_type="raw"} > 1000
    for: 1h
    labels:
      severity: warning
      remediation: manual
    annotations:
      summary: "{{ "{{ $labels.device }}" }} has {{ "{{ $value }}" }} reallocated sectors ({{ "{{ $labels.instance }}" }})"
      description: "Reallocated_Sector_Ct={{ "{{ $value }}" }} on {{ "{{ $labels.device }}" }}. SMART may still report PASSED; this is heavy wear — schedule replacement."

- name: memory_alerts
  rules:
  # ECC-corrected memory errors. node_exporter's edac collector already exports
  # these on the bare-metal hosts; before this rule nothing alerted, so a failing
  # DIMM was only ever found by a hand-run ras-mc-ctl/EDAC check. Correctable =
  # the bit-flip WAS fixed, but a rising count means a DIMM is degrading.
  # remediation: manual -> ntfy the human, never the code lane (no PR swaps a DIMM).
  - alert: EccCorrectableErrors
    expr: increase(node_edac_correctable_errors_total[1h]) > 0
    for: 15m
    labels:
      severity: warning
      remediation: manual
    annotations:
      summary: "ECC correctable errors on {{ "{{ $labels.instance }}" }} (mc{{ "{{ $labels.controller }}" }})"
      description: "{{ "{{ $value }}" }} correctable ECC errors in the last hour on controller {{ "{{ $labels.controller }}" }} of {{ "{{ $labels.instance }}" }}. The error was corrected, but a rising count flags a failing DIMM; identify it (ras-mc-ctl / iDRAC) and schedule replacement."

  # Uncorrectable ECC = data the ECC could NOT fix. Imminent DIMM failure and a
  # real corruption risk (this is the class of fault we ruled out for the data01
  # checksum errors); page immediately.
  - alert: EccUncorrectableErrors
    expr: increase(node_edac_uncorrectable_errors_total[1h]) > 0
    for: 0m
    labels:
      severity: critical
      remediation: manual
    annotations:
      summary: "UNCORRECTABLE ECC errors on {{ "{{ $labels.instance }}" }} (mc{{ "{{ $labels.controller }}" }})"
      description: "{{ "{{ $value }}" }} uncorrectable ECC errors on controller {{ "{{ $labels.controller }}" }} of {{ "{{ $labels.instance }}" }}. ECC could not correct these; a DIMM is failing and data integrity is at risk. Replace the DIMM."

- name: backup_alerts
  rules:
  # The nightly DB backup writes homelab_db_backup_* to the node_exporter
  # textfile collector. Staleness catches a backup that silently stopped
  # running (timer dead, host down at 03:30, upload wedged); the value is
  # carried forward on failure so the age keeps growing until a clean run.
  - alert: DbBackupStale
    expr: time() - homelab_db_backup_last_success_timestamp_seconds > 129600
    for: 30m
    labels:
      severity: warning
    annotations:
      summary: "Homelab DB backup is stale ({{ "{{ $labels.instance }}" }})"
      description: "No fully-successful homelab database backup in over 36h. The nightly timer may be dead, the host down at 03:30, or the GCS upload wedged. Check `systemctl status db-backup.service` and the last db_backup.prom on {{ "{{ $labels.instance }}" }}."

  # A run that completed but with per-DB failures (a dump errored) - the tarball
  # is incomplete even if it uploaded.
  - alert: DbBackupFailing
    expr: homelab_db_backup_failed > 0
    for: 15m
    labels:
      severity: warning
    annotations:
      summary: "Homelab DB backup completed with {{ "{{ $value }}" }} failed database(s)"
      description: "The last backup run on {{ "{{ $labels.instance }}" }} failed to dump {{ "{{ $value }}" }} in-scope database(s); the tarball is incomplete. Check the db-backup.service journal for which."

- name: sas_phy_alerts
  rules:
  # SAS transport counters are cumulative, so alert on the RATE of increase (a
  # static historical count from one bad moment must not page). Invalid dwords
  # climbing fast = a marginal cable / backplane lane / expander phy - the class
  # of physical-layer fault behind correlated ZFS checksum errors. remediation:
  # manual (reseat/replace the cable or drive caddy; no PR fixes a wire).
  - alert: SasPhyErrorsRising
    expr: increase(sas_phy_invalid_dword_total[1h]) + increase(sas_phy_running_disparity_error_total[1h]) > 1000
    for: 15m
    labels:
      severity: warning
      remediation: manual
    annotations:
      summary: "SAS phy {{ "{{ $labels.phy }}" }} accumulating link errors ({{ "{{ $labels.instance }}" }})"
      description: "{{ "{{ $value | humanize }}" }} invalid-dword/disparity errors in the last hour on SAS phy {{ "{{ $labels.phy }}" }} (sas_addr {{ "{{ $labels.sas_address }}" }}) of {{ "{{ $labels.instance }}" }}. A cable, backplane lane, or expander phy is degrading; reseat or replace it."

  # Loss-of-dword-sync / phy resets = the link is actually dropping and
  # re-syncing, more serious than dword errors. Any sustained increase pages.
  - alert: SasPhyLinkResync
    expr: increase(sas_phy_loss_of_dword_sync_total[1h]) + increase(sas_phy_reset_problem_total[1h]) > 10
    for: 15m
    labels:
      severity: warning
      remediation: manual
    annotations:
      summary: "SAS phy {{ "{{ $labels.phy }}" }} link is resetting/losing sync ({{ "{{ $labels.instance }}" }})"
      description: "{{ "{{ $value | humanize }}" }} loss-of-sync/reset events in the last hour on SAS phy {{ "{{ $labels.phy }}" }} of {{ "{{ $labels.instance }}" }}. The physical link is unstable; check the cable/backplane connection to that drive."

- name: ipmi_alerts
  rules:
  # In-band ipmi_exporter reads the Dell iDRAC BMC on node005/node006 (the only
  # [baremetal] hosts). The BMC applies each sensor's OWN thresholds and reports
  # a rolled-up state, so we alert on that state rather than hardcoding a temp/
  # RPM/voltage number the BMC already knows better than we do. All ipmi rules
  # are remediation: manual -> ntfy the human; no PR reseats a PSU or a DIMM.
  #
  # NOTE: "Entity Presence" sensors read state=2 on healthy R620/R720 chassis
  # (a freeipmi mapping quirk for backplane/riser presence bits), so every
  # sensor rule excludes that type or it would page on nominal hardware. The
  # chassis_*_fault_state metrics are likewise unreliable here (cooling/drive
  # fault bits read 1 on both healthy nodes), so we do NOT alert on them - the
  # per-sensor Fan/Drive-Slot states below are the trustworthy signal.
  - alert: IpmiExporterDown
    expr: ipmi_up == 0
    for: 10m
    labels:
      severity: warning
      remediation: manual
    annotations:
      summary: "IPMI/BMC unreachable on {{ "{{ $labels.instance }}" }}"
      description: "The in-band ipmi_exporter has been unable to read the BMC on {{ "{{ $labels.instance }}" }} for 10m (collector {{ "{{ $labels.collector }}" }}). Hardware health for this Dell host is now blind - check the exporter container and /dev/ipmi0."

  # A sensor the BMC reports as Critical (state=2): temp over the upper-critical
  # threshold, a fan stopped, a PSU lost AC/redundancy, a CPU/DIMM fault. This
  # is real hardware in trouble - page and get hands on it.
  - alert: IpmiSensorCritical
    expr: ipmi_sensor_state{type!="Entity Presence"} == 2
    for: 5m
    labels:
      severity: critical
      remediation: manual
    annotations:
      summary: "IPMI sensor CRITICAL: {{ "{{ $labels.name }}" }} ({{ "{{ $labels.type }}" }}) on {{ "{{ $labels.instance }}" }}"
      description: "BMC reports sensor '{{ "{{ $labels.name }}" }}' (type {{ "{{ $labels.type }}" }}) in CRITICAL state on {{ "{{ $labels.instance }}" }}. Current reading in the Dell Hardware (IPMI) dashboard. Check the iDRAC and the physical part (fan/PSU/DIMM/CPU)."

  # Non-critical / warning state (state=1): approaching a threshold. Longer for:
  # to ride out a brief thermal excursion under load.
  - alert: IpmiSensorWarning
    expr: ipmi_sensor_state{type!="Entity Presence"} == 1
    for: 15m
    labels:
      severity: warning
      remediation: manual
    annotations:
      summary: "IPMI sensor warning: {{ "{{ $labels.name }}" }} ({{ "{{ $labels.type }}" }}) on {{ "{{ $labels.instance }}" }}"
      description: "BMC reports sensor '{{ "{{ $labels.name }}" }}' (type {{ "{{ $labels.type }}" }}) in a non-critical warning state on {{ "{{ $labels.instance }}" }} for 15m. Approaching a threshold; check the Dell Hardware (IPMI) dashboard before it escalates."
