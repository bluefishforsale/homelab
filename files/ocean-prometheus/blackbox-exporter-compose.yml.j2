# Blackbox exporter as a compose project so docker-refresh@blackbox-exporter
# keeps the image current.
services:
  blackbox-exporter:
    image: {{ blackbox_exporter_image }}:{{ blackbox_exporter_version }}
    container_name: {{ blackbox_exporter_service }}
    hostname: {{ blackbox_exporter_service }}
    restart: unless-stopped
    environment:
      - TZ=America/Los_Angeles
    ports:
      - "{{ blackbox_exporter_port }}:9115"
    volumes:
      - /usr/share/zoneinfo:/usr/share/zoneinfo:ro
      - {{ path_home }}/config:/config
    command:
      - --config.file=/config/blackbox.yml
      - --log.level=warn
      - --log.prober=warn
    healthcheck:
      test: ["CMD", "wget", "-qO", "/dev/null", "http://localhost:9115/-/healthy"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 20s
