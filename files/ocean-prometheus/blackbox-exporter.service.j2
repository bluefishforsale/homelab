[Unit]
Description=blackbox-exporter
After=docker.service zfs-mount.service zfs-import.target network-online.target
Requires=docker.service zfs-mount.service zfs-import.target
Wants=network-online.target
RequiresMountsFor=/data01

[Service]
# Compose project so the refresh timer sees it; crash recovery is the container's
# own `restart: unless-stopped`, since Restart= is not valid on a oneshot.
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/compose/blackbox-exporter
StandardOutput=journal
StandardError=journal
ExecStart=/usr/bin/docker compose -f /opt/compose/blackbox-exporter/docker-compose.yml up -d
ExecStop=/usr/bin/docker compose -f /opt/compose/blackbox-exporter/docker-compose.yml down --timeout 30
TimeoutStartSec=300
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
