# my global config
global:
  scrape_interval:     15s # Set the scrape interval to every 15 seconds. Default is every 1 minute.
  evaluation_interval: 15s # Evaluate rules every 15 seconds. The default is every 1 minute.
  # scrape_timeout is set to the global default (10s).

# Alertmanager configuration
alerting:
  alertmanagers:
  - static_configs:
    - targets:
      - ocean.home:9093

# Load rules once and periodically evaluate them according to the global 'evaluation_interval'.
rule_files:
  - "alert_rules.yml"

# A scrape configuration containing exactly one endpoint to scrape:
# Here it's Prometheus itself.
scrape_configs:
  # The job name is added as a label `job=<job_name>` to any timeseries scraped from this config.
  # metrics_path defaults to '/metrics'
  # scheme defaults to 'http'.
  - job_name: 'pve'
    relabel_configs: &dropPortNumber
    - source_labels: [__address__]
      regex: "([^:]+):\\d+"
      target_label: instance
    static_configs:
    - targets:
        - node005.home:9221
    metrics_path: /pve
    params:
      module: [default]
      cluster: ['1']
      node: ['1']
      # target is the PVE host the exporter queries over the API; without it the
      # exporter has no host to talk to and returns 500. node005 mgmt IP is stable.
      target: ['192.168.1.105']

  # In-band IPMI on the Dell bare-metal hosts (PSU/fan/temp/voltage/SEL). freeipmi
  # collection is slow, so a long interval/timeout keeps scrapes from overlapping.
  - job_name: 'ipmi'
    relabel_configs: *dropPortNumber
    scrape_interval: 60s
    scrape_timeout: 30s
    static_configs:
    - targets: ['node005.home:9290', 'node006.home:9290']

  - job_name: 'prometheus'
    relabel_configs: &dropPortNumber
    - source_labels: [__address__]
      regex: "([^:]+):\\d+"
      target_label: instance
    static_configs:
    - targets: ['ocean.home:9090']

  - job_name: 'alertmanager'
    relabel_configs: *dropPortNumber
    static_configs:
    - targets: ['ocean.home:9093']

  - job_name: 'node_exporter'
    scrape_interval: 30s
    scrape_timeout: 30s
    relabel_configs: *dropPortNumber
    static_configs:
{% for host in groups['all'] %}
    - targets: ['{{ host }}.home:9100']
{% endfor %}

  # Diskless netboot machines (vars/vars_netboot.yaml). Not in inventory and
  # off most of the day, so they get their own job, which ServiceDown skips.
  # Scraped by address, not name: Kea hands the address out only to the live
  # image, while <name>.home follows whatever the machine last booted (DDNS),
  # which on the tower is usually Windows.
  - job_name: 'netboot-hosts'
    scrape_interval: 30s
    static_configs:
{% for name, host in netboot_hosts.items() if name != 'netboot-smoke' %}
    - targets: ['{{ host.ip }}:9100']
      labels:
        instance: '{{ name }}-live'
{% endfor %}

  - job_name: 'process-exporter'
    relabel_configs: *dropPortNumber
    static_configs:
    - targets: ['ocean.home:9256']

  - job_name: 'cadvisor'
    relabel_configs: *dropPortNumber
    static_configs:
{# agentbox and pihole run no Docker, so no cadvisor container #}
{% for host in groups['all'] if host not in ['agentbox', 'pihole'] %}
    - targets: ['{{ host }}.home:8912']
{% endfor %}

  - job_name: 'fail2ban-exporter'
    relabel_configs: *dropPortNumber
    static_configs:
{# agentbox and pihole run no Docker, so no fail2ban-exporter container #}
{% for host in groups['all'] if host not in ['agentbox', 'pihole'] %}
    - targets: ['{{ host }}.home:9191']
{% endfor %}

  - job_name: 'nvidia-exporter'
    relabel_configs: *dropPortNumber
    static_configs:
    - targets: ['ocean.home:9400']

  - job_name: 'nvidia-gpu-exporter'
    relabel_configs: *dropPortNumber
    static_configs:
    - targets: ['ocean.home:9445']

  - job_name: 'smart-exporter'
    relabel_configs: *dropPortNumber
    static_configs:
{# Every host runs the exporter, but the other VMs only see a QEMU virtual
   disk with no SMART data. ocean is the one VM with real disks: the data01
   pool's drives are passed through to it. #}
{% for host in groups['baremetal'] + ['ocean'] %}
    - targets: ['{{ host }}.home:9633']
{% endfor %}

  - job_name: 'unpoller'
    relabel_configs: *dropPortNumber
    static_configs:
    - targets: ['ocean.home:9130']

  - job_name: 'tautulli-exporter'
    relabel_configs: *dropPortNumber
    static_configs:
    - targets: ['ocean.home:8913']

  - job_name: 'plex-exporter'
    relabel_configs: *dropPortNumber
    scrape_interval: 1m
    scrape_timeout: 15s
    static_configs:
    - targets: ['ocean.home:9594']

  - job_name: 'jellyfin-exporter'
    relabel_configs: *dropPortNumber
    scrape_interval: 1m
    scrape_timeout: 15s
    static_configs:
    - targets: ['ocean.home:9027']

  - job_name: 'radarr-exporter'
    relabel_configs: *dropPortNumber
    scrape_interval: 3m
    scrape_timeout: 2m
    static_configs:
    - targets: ['ocean.home:9707']

  - job_name: 'sonarr-exporter'
    relabel_configs: *dropPortNumber
    # NOTE: ENABLE_ADDITIONAL_METRICS makes exportarr v2 walk every series
    # serially (~1,150 API calls at 574 series), so a scrape runs 65-105s and
    # flapped at a 2m timeout. Keep the interval under the 5m staleness lookback
    # or the series go absent between scrapes.
    scrape_interval: 4m
    scrape_timeout: 3m50s
    static_configs:
    - targets: ['ocean.home:9708']

  - job_name: 'prowlarr-exporter'
    relabel_configs: *dropPortNumber
    scrape_interval: 3m
    scrape_timeout: 2m
    static_configs:
    - targets: ['ocean.home:9710']

  - job_name: 'nzbget-exporter'
    relabel_configs: *dropPortNumber
    scrape_interval: 30s
    scrape_timeout: 15s
    static_configs:
    - targets: ['harbor.home:9452']

  # Jellyfin has no native /metrics endpoint (:8096/metrics 404s); its metrics
  # come from the jellyfin-exporter job above. This direct scrape only produced
  # a chronic false ServiceDown, so it is removed.

  - job_name: 'ndt-exporter'
    relabel_configs: *dropPortNumber
    scrape_interval: 5m
    scrape_timeout: 90s
    static_configs:
    - targets: ['ocean.home:9140']

  - job_name: 'cloudflare-exporter-terrac'
    relabel_configs: *dropPortNumber
    scrape_interval: 5m
    scrape_timeout: 60s
    static_configs:
    - targets: ['ocean.home:9199']

  # Tdarr via its API; each scrape reads the whole job history (~30 MB), so
  # the interval is relaxed and the timeout covers a busy server.
  - job_name: 'tdarr-exporter'
    relabel_configs: *dropPortNumber
    scrape_interval: 2m
    scrape_timeout: 60s
    static_configs:
    - targets: ['ocean.home:9196']

  # Emporia smart plugs via the cloud API; the exporter polls once a minute.
  - job_name: 'emporia-exporter'
    relabel_configs: *dropPortNumber
    scrape_interval: 60s
    static_configs:
    - targets: ['ocean.home:9198']

  # The three UPSes on node005's NUT server, one scrape per UPS (the exporter
  # reads one UPS per request, chosen by ?ups=). Target = NUT UPS name.
  - job_name: 'nut'
    metrics_path: /ups_metrics
    scrape_interval: 30s
    static_configs:
    - targets: ['ups-3B2116X60966', 'ups-3B2037X27090', 'ups-3B2116X60175']
    relabel_configs:
    - source_labels: [__address__]
      target_label: __param_ups
    - source_labels: [__address__]
      target_label: ups
    - source_labels: [__address__]
      target_label: instance
    - target_label: __address__
      replacement: ocean.home:9197

  - job_name: 'mtr-exporter'
    relabel_configs: *dropPortNumber
    scrape_interval: 60s
    scrape_timeout: 30s
    static_configs:
    - targets: ['ocean.home:9141']

  - job_name: 'promtail'
    relabel_configs: *dropPortNumber
    scrape_interval: 15s
    scrape_timeout: 10s
    static_configs:
    - targets: ['ocean.home:9080']  # Ocean (with syslog listener)
    - targets: ['node005.home:9080']
    - targets: ['node006.home:9080']
    - targets: ['dns01.home:9080']
    - targets: ['dns02.home:9080']
    - targets: ['agentbox.home:9080']

  - job_name: 'powerdns'
    relabel_configs: *dropPortNumber
    scrape_interval: 30s
    scrape_timeout: 10s
    metrics_path: /metrics
    static_configs:
    - targets: ['192.168.1.3:8081']

  - job_name: 'kea-exporter'
    relabel_configs: *dropPortNumber
    scrape_interval: 30s
    scrape_timeout: 10s
    static_configs:
    - targets: ['192.168.1.3:9547']

  - job_name: 'llamacpp'
    relabel_configs: *dropPortNumber
    scrape_interval: 15s
    scrape_timeout: 10s
    authorization:
      type: Bearer
      # NOTE: deliberately no `| default(...)`. A fallback credential committed
      # to a public repo is worse than a render failure, because it would
      # authenticate silently with a string anyone can read. If the vault key
      # goes missing, this must fail loudly rather than fall back.
      credentials: "{{ ai_services.llamacpp.api_key }}"
    static_configs:
    - targets: ['ocean.home:8080']

  - job_name: 'paia'
    relabel_configs: *dropPortNumber
    scrape_interval: 30s
    scrape_timeout: 10s
    static_configs:
    - targets: ['ocean.home:9092']

  # agentbox OTel collector: Claude Code + opencode cost/token/request metrics.
  # repo/lane/service arrive as labels (resource_to_telemetry_conversion).
  - job_name: 'agentbox-otelcol'
    relabel_configs: *dropPortNumber
    scrape_interval: 30s
    scrape_timeout: 10s
    static_configs:
    - targets: ['agentbox.home:9464']

  # my-ta-jose paper grading app. /metrics is unauthenticated, so it is only
  # ever scraped over the internal host port (ocean.home -> 192.168.1.143),
  # never via the public ta.terrac.com tunnel (nginx blocks /metrics there).
  - job_name: 'my-ta-jose'
    relabel_configs: *dropPortNumber
    scrape_interval: 30s
    scrape_timeout: 10s
    metrics_path: /metrics
    static_configs:
    - targets: ['ocean.home:8092']
      labels:
        service: my-ta-jose
        host: ocean

  # HTTP Probes - Web services and APIs
  - job_name: 'blackbox-http'
    metrics_path: /probe
    params:
      module: [http_2xx]
    scrape_interval: 30s
    static_configs:
      - targets:
        # Major websites
        - https://google.com
        - https://cloudflare.com
        - https://github.com
        - https://reddit.com
        - https://youtube.com
        - https://wikipedia.org
        - https://aws.amazon.com
        - https://docker.com
        labels:
          probe_type: "http"
          category: "major_sites"
      - targets:
        # Cloud providers
        - https://console.aws.amazon.com
        - https://portal.azure.com
        - https://app.netlify.com
        - https://vercel.com
        - https://digitalocean.com
        labels:
          probe_type: "http"
          category: "cloud_providers"
      - targets:
        # Development services
        - https://registry.npmjs.org
        - https://pypi.org
        - https://hub.docker.com
        - https://quay.io
        - https://gcr.io
        labels:
          probe_type: "http"
          category: "dev_services"
      - targets:
        # Media/Entertainment
        - https://netflix.com
        - https://twitch.tv
        - https://spotify.com
        - https://discord.com
        - https://slack.com
        labels:
          probe_type: "http"
          category: "media"
      - targets:
        # Personal/Project sites
        - https://terrac.com
        - https://blog.saetnere.com
        - https://belief-systems.com
        labels:
          probe_type: "http"
          category: "personal"
      - targets:
        # Homelab services that expose no metrics of their own, so a probe is
        # the only signal they are actually serving. /docs is mem0's one
        # unauthenticated route; it is served by the same app as /memories.
        - http://ocean.home:8888/docs
        # netboot01's nginx serves netboot images and role bundles to PXE clients.
        - http://netboot01.home/healthz
        labels:
          probe_type: "http"
          category: "homelab_services"
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: ocean.home:9115

  # HTTPS/TLS Certificate Probes. A TLS handshake, not an HTTP GET: the cert
  # and reachability are what this job checks, and an HTTP status (google's
  # 301, a bot wall's 403) said nothing about either. Sites that bot-wall a
  # GET (quizlet, linode) live here rather than in blackbox-http for the same
  # reason.
  - job_name: 'blackbox-tls'
    metrics_path: /probe
    params:
      module: [tcp_tls]
    scrape_interval: 1h
    static_configs:
      - targets:
        # Critical TLS endpoints
        - terrac.com:443
        - github.com:443
        - google.com:443
        - cloudflare.com:443
        - aws.amazon.com:443
        - quizlet.com:443
        - el.quizlet.com:443
        - linode.com:443
        - belief-systems.com:443
        labels:
          probe_type: "tls"
          category: "certificate_check"
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: ocean.home:9115

  # TLS Probes - Plex WAN path (IPv4-forced; redirect-tolerant)
  - job_name: 'blackbox-tls-plex'
    metrics_path: /probe
    params:
      module: [http_tls_ip4]
    scrape_interval: 1h
    static_configs:
      - targets:
        # Plex path
        - https://plex.tv:443
        labels:
          probe_type: "tls"
          category: "plex_path"
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: ocean.home:9115

  # ICMP Ping Probes - Network connectivity
  - job_name: 'blackbox-icmp'
    metrics_path: /probe
    params:
      module: [icmp]
    scrape_interval: 30s
    static_configs:
      - targets:
        # DNS providers
        - 1.0.0.1
        - 1.1.1.1
        - 8.8.4.4
        - 8.8.8.8
        - 9.9.9.9
        - 208.67.222.222
        labels:
          probe_type: "icmp"
          category: "dns_servers"
      - targets:
        # CDN providers
        - 104.16.132.229  # Cloudflare
        - 13.107.42.14    # Microsoft
        - 151.101.1.140   # Fastly
        labels:
          probe_type: "icmp"
          category: "cdn_providers"
      - targets:
        # Major internet infrastructure
        - nexthop.anarc.at
        - cixp.web.cern.ch
        - cam.ac.uk
        - web.mit.edu
        labels:
          probe_type: "icmp"
          category: "infrastructure"
      - targets:
        # Local network
        - 192.168.1.1     # Router
        - 192.168.1.143   # Ocean server
        labels:
          probe_type: "icmp"
          category: "local_network"
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: ocean.home:9115

  # DNS Probes - Domain resolution
  - job_name: 'blackbox-dns'
    metrics_path: /probe
    params:
      module: [dns_tcp]
    scrape_interval: 1m
    static_configs:
      - targets:
        # Test DNS resolution through different servers
        - 1.1.1.1:53
        - 8.8.8.8:53
        - 9.9.9.9:53
        - 208.67.222.222:53
        labels:
          probe_type: "dns"
          category: "dns_tcp"
      - targets:
        # Local DNS
        - 192.168.1.1:53
        - 192.168.1.3:53
        labels:
          probe_type: "dns"
          category: "local_dns"
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: ocean.home:9115

  # TCP Probes - Service ports
  - job_name: 'blackbox-tcp'
    metrics_path: /probe
    params:
      module: [tcp_connect]
    scrape_interval: 1m
    static_configs:
      - targets:
        # SSH services
        - github.com:22
        - gitlab.com:22
        labels:
          probe_type: "tcp"
          category: "ssh"
      - targets:
        # SMTP services
        - smtp.gmail.com:587
        labels:
          probe_type: "tcp"
          category: "smtp"
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: ocean.home:9115

  # TCP Probes - Plex WAN path (IPv4-forced; targets are dual-stack but ocean has no IPv6 uplink).
  # Only stable, published endpoints belong here: plex.tv is the Plex API control
  # plane; 1.1.1.1 is the internet control to tell 'Plex path bad' from 'internet
  # bad'. The pubsub POP node from the 2026-04-26 incident (pubsub04.pop.fmt.plex.bz)
  # was intentionally dropped: Plex assigns pubsub POP nodes dynamically, so a
  # hardcoded node hard-fails permanently once Plex retires it, firing a chronic
  # false PlexPathDegraded critical (issue #175).
  - job_name: 'blackbox-tcp-plex'
    metrics_path: /probe
    params:
      module: [tcp_connect_ip4]
    scrape_interval: 1m
    static_configs:
      - targets:
        # Plex path
        - plex.tv:443
        - 1.1.1.1:443
        labels:
          probe_type: "tcp"
          category: "plex_path"
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: ocean.home:9115

  # HTTP Probes for APIs - JSON/REST endpoints  
  - job_name: 'blackbox-api'
    metrics_path: /probe
    params:
      module: [http_api_json]
    scrape_interval: 2m
    static_configs:
      - targets:
        # Public APIs. Nothing rate-limited without a token: api.github.com
        # allows 60 unauthenticated calls an hour and answered 403 most of
        # the day; githubstatus.com is the unmetered signal for GitHub.
        - https://www.githubstatus.com/api/v2/status.json
        - https://httpbin.org/json
        - https://jsonplaceholder.typicode.com/posts/1
        labels:
          probe_type: "http_api"
          category: "public_apis"
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: ocean.home:9115

  # HTTP Probes with specific response codes
  - job_name: 'blackbox-http-status'
    metrics_path: /probe
    params:
      module: [http_4xx]
    scrape_interval: 5m
    static_configs:
      - targets:
        # Expected 4xx responses
        - https://httpbin.org/status/404
        - https://httpbin.org/status/403
        labels:
          probe_type: "http_status"
          category: "expected_errors"
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: ocean.home:9115

  # Docker registry pull-through cache (per-upstream container metrics)
  - job_name: 'registry-cache'
    metrics_path: /metrics
    static_configs:
      - targets:
        - registry-cache.home:5011
        - registry-cache.home:5012
        - registry-cache.home:5013
        - registry-cache.home:5014
    relabel_configs:
      - source_labels: [__address__]
        regex: '.*:5011'
        target_label: upstream
        replacement: docker-hub
      - source_labels: [__address__]
        regex: '.*:5012'
        target_label: upstream
        replacement: ghcr
      - source_labels: [__address__]
        regex: '.*:5013'
        target_label: upstream
        replacement: gitlab
      - source_labels: [__address__]
        regex: '.*:5014'
        target_label: upstream
        replacement: nvcr

  # Internal Service Health Checks
  # Services whose only unauthenticated answer is a 4xx. A 401 here is a pass:
  # it proves the listener, the HTTP layer and the auth middleware are all alive.
  # The MCP bridge is how agentbox and every other off-box agent reaches mem0,
  # so "is the connector up" is a different question from "is the API up".
  - job_name: 'blackbox-http-4xx'
    metrics_path: /probe
    params:
      module: [http_4xx]
    scrape_interval: 30s
    static_configs:
      - targets:
        - http://ocean.home:8766/mcp
        labels:
          probe_type: "http"
          category: "homelab_services"
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: ocean.home:9115

  - job_name: 'blackbox-internal'
    metrics_path: /probe
    params:
      module: [http_2xx]
    scrape_interval: 15s
    static_configs:
      - targets:
        # Internal homelab services
        # Each path is one the service answers 2xx without auth.
        - https://192.168.1.143:32400/identity  # Plex (Secure connections: Required)
        - http://192.168.1.143:8910    # Grafana
        - http://192.168.1.143:9090    # Prometheus
        - http://192.168.1.143:8080/health      # LlamaCPP
        - http://192.168.1.3:8081      # PowerDNS API
        labels:
          probe_type: "http"
          category: "internal_services"
      - targets:
        # Kea's control agent only takes a JSON POST; a GET is a 400.
        - http://192.168.1.3:8000      # Kea Control Agent
        labels:
          probe_type: "http"
          category: "internal_services"
    relabel_configs:
      # A __param_module target label does not override the job's params;
      # a relabel rule does.
      - source_labels: [__address__]
        regex: 'http://192\.168\.1\.3:8000'
        target_label: __param_module
        replacement: kea_version
      - source_labels: [__address__]
        regex: 'https://192\.168\.1\.143:32400/.*'
        target_label: __param_module
        replacement: http_2xx_insecure
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: ocean.home:9115


