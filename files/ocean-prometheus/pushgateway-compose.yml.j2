services:
  pushgateway:
    image: {{ pushgateway_image }}:{{ pushgateway_version }}
    container_name: {{ pushgateway_service }}
    restart: unless-stopped

    ports:
      - "{{ pushgateway_port }}:9091"

    # Persisted so a batch job's last-success timestamp survives a restart;
    # without it the staleness alerts would fire after every reboot.
    command:
      - --persistence.file=/data/pushgateway.db
      - --persistence.interval=5m

    volumes:
      - {{ pushgateway_home }}/data:/data

    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://localhost:9091/-/healthy"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 20s

    security_opt:
      - no-new-privileges:true

    deploy:
      resources:
        limits:
          memory: 128M
        reservations:
          memory: 32M

    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

    network_mode: bridge
