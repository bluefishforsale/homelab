[Unit]
Description={{ exporter_service }}
# HTTP client of Prowlarr's API only; it never touches /data01 or ZFS. Keep the
# deps minimal (like the sonarr/radarr exporters) so a zfs-mount/import flap can't
# hard-stop this unit and leave it permanently down (ServiceDown).
After=docker.service prowlarr.service
Requires=docker.service
Wants=prowlarr.service

[Service]
Type=simple
StandardOutput=journal
StandardError=journal
RuntimeMaxSec=7d
Restart=always
RestartSec=120s
TimeoutStartSec=180s
ExecStartPre=-docker rm -f {{ exporter_service }}
ExecStartPre=-docker images --filter reference={{ exporter_image }}:{{ exporter_version }} -q | xargs docker rmi -f
ExecStartPre=-/usr/bin/docker pull {{ exporter_image }}:{{ exporter_version }}
ExecStart=docker run --rm \
    --name=%N \
    --hostname=%H \
    -e TZ="America/Los_Angeles" \
    -e VERSION={{ exporter_version }} \
    -e PORT={{ exporter_port }} \
    -e URL="http://ocean.home:{{ prowlarr_port }}" \
    -e APIKEY="{{ media_services.prowlarr.api_key }}" \
    -e ENABLE_ADDITIONAL_METRICS=true \
    -p {{ exporter_port }}:9710 \
    {{ exporter_image }}:{{ exporter_version }} prowlarr
ExecStop=docker rm -f %N

[Install]
WantedBy=multi-user.target
