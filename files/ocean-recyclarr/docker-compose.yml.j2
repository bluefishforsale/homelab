# Recyclarr syncs TRaSH Guides custom formats, scores and quality sizes into
# Sonarr and Radarr once a day. It is a compose project so docker-refresh@recyclarr
# keeps the image current within major version 8.
services:
  recyclarr:
    image: {{ image }}:{{ version }}
    container_name: {{ service }}
    hostname: {{ service }}
    restart: unless-stopped
    # Host network so the config reaches Sonarr and Radarr on 127.0.0.1.
    network_mode: host
    user: "{{ uid }}:{{ gid }}"
    environment:
      - TZ=America/Los_Angeles
      - CRON_SCHEDULE={{ schedule }}
      - SONARR_API_KEY={{ media_services.sonarr.api_key }}
      - RADARR_API_KEY={{ media_services.radarr.api_key }}
    volumes:
      - /usr/share/zoneinfo:/usr/share/zoneinfo:ro
      - {{ home }}:/config
    healthcheck:
      test: ["CMD", "pgrep", "supercronic"]
      interval: 60s
      timeout: 10s
      retries: 3
    security_opt:
      - no-new-privileges:true
    cpus: '1.0'
    mem_limit: 512m
