# Sonarr and its exporter, one compose project so docker-refresh@sonarr keeps
# both images current.
services:
  sonarr:
    image: {{ image }}:{{ version }}
    container_name: {{ service }}
    hostname: {{ service }}
    restart: unless-stopped
    environment:
      - TZ=America/Los_Angeles
      - PUID={{ uid }}
      - PGID={{ gid }}
    extra_hosts:
      - "home.terrac.com:{{ ansible_default_ipv4.address }}"
    ports:
      - "{{ sonarr_port }}:8902"
    volumes:
      - /usr/share/zoneinfo:/usr/share/zoneinfo:ro
      - /etc/localtime:/etc/localtime:ro
      - {{ home }}:/config
      - {{ incoming }}/tv:/downloads
      - {{ complete }}/tv:/tv
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://localhost:8902/ping || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 120s
    security_opt:
      - no-new-privileges:true
    # No mem_limit: it peaks around 1.4 GiB with the library loaded, and an OOM
    # kill mid-import is worse than the memory.
    cpus: '4.0'

  sonarr-exporter:
    image: {{ exporter_image }}:{{ exporter_version }}
    volumes:
      - /usr/share/zoneinfo:/usr/share/zoneinfo:ro
    container_name: {{ exporter_service }}
    hostname: {{ exporter_service }}
    restart: unless-stopped
    command: ["sonarr"]
    environment:
      - TZ=America/Los_Angeles
      - URL=http://{{ service }}:8902
      - API_KEY={{ media_services.sonarr.api_key }}
      - PORT={{ exporter_port }}
    # NOTE: no ENABLE_ADDITIONAL_METRICS. It makes exportarr fetch episode,
    # episodefile and qualitydefinition once per series, ~2,550 serial calls at
    # 851 series, to add only episode quality and per-episode monitored counts.
    # Measured 2026-11-02: Sonarr ran at ~13 cores during a scrape vs ~1.2
    # between, the scrape took 68-193s, and one failed call anywhere voided the
    # whole scrape.
    ports:
      - "{{ exporter_port }}:{{ exporter_port }}"
    # No healthcheck: the image has no shell. up{job="sonarr-exporter"} covers it.
    depends_on:
      - sonarr
    security_opt:
      - no-new-privileges:true
    cpus: '0.5'
    mem_limit: 256m
