[Unit]
Description={{ exporter_service }}
After=docker.service sonarr.service
Requires=docker.service
Wants=sonarr.service

[Service]
Type=simple
StandardOutput=journal
StandardError=journal
# Deliberately no RuntimeMaxSec here, unlike sonarr.service. The playbook starts
# both units together, so a shared 7d cap expires them within seconds of each
# other. The exporter then returns on RestartSec=10s into a sonarr that has not
# begun starting yet (its own RestartSec=120s, plus an image pull and app boot),
# so :{{ exporter_port }} serves nothing for several minutes and Prometheus
# records up==0 long enough to trip ServiceDown (#137, #236, #330).
# radarr-exporter omits RuntimeMaxSec and has never shown this alert. The image
# still refreshes via the ExecStartPre pull on every playbook-driven restart.
Restart=always
RestartSec=10s
TimeoutStartSec=300s
ExecStartPre=-docker rm -f {{ exporter_service }}
ExecStartPre=-docker images --filter reference={{ exporter_image }}:{{ exporter_version }} -q | xargs docker rmi -f
ExecStartPre=-/usr/bin/docker pull {{ exporter_image }}:{{ exporter_version }}
ExecStart=docker run --rm \
    --name {{ exporter_service }} \
    --hostname {{ exporter_service }} \
    -e TZ="America/Los_Angeles" \
    -e VERSION={{ exporter_version }} \
    -e URL=http://{{ hostvars[inventory_hostname]['ansible_default_ipv4']['address'] }}:{{ sonarr_port }} \
    -e PORT={{ exporter_port }} \
    -e ENABLE_ADDITIONAL_METRICS=true \
    -p {{ exporter_port }}:{{ exporter_port }} \
    -e APIKEY="{{ media_services.sonarr.api_key }}" \
    {{ exporter_image }}:{{ exporter_version }} \
      sonarr
ExecStop=docker rm -f %N

[Install]
WantedBy=multi-user.target
