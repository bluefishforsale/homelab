      "id": "e5"
    },
    {
      "source": "requireNvenc",
      "sourceHandle": "1",
      "target": "encodeAll",
      "targetHandle": null,
      "id": "e23"
    },
    {
      "source": "encodeAll",
      "sourceHandle": "1",
      "target": "setContainer",
      "targetHandle": null,
      "id": "e6"
    },
    {
      "source": "setContainer",
      "sourceHandle": "1",
      "target": "execute",
      "targetHandle": null,
      "id": "e7"
    },
    {
      "source": "execute",
      "sourceHandle": "1",
      "target": "compareSize",
      "targetHandle": null,
      "id": "e8"
    },
    {
      "source": "compareSize",
      "sourceHandle": "1",
      "target": "compareDuration",
      "targetHandle": null,
      "id": "e9"
    },
    {
      "source": "compareSize",
