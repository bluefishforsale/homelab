      "target": "compareDuration",
      "targetHandle": null,
      "id": "e10"
    },
    {
      "source": "compareDuration",
      "sourceHandle": "1",
      "target": "replace",
      "targetHandle": null,
      "id": "e11"
    },
    {
      "source": "compareDuration",
