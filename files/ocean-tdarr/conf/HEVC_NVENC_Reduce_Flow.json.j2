{
  "_id": "MinimalHEVC",
  "name": "HEVC NVenc - Minimal Single-Plugin",
  "description": "Audio policy on every file (files/ocean-tdarr/conf/audio-policy.js); HEVC encode for non-HEVC video: hevc_nvenc on an NVENC GPU worker, libx265 CRF 23 on a CPU worker (harbor), hevc_qsv ICQ 20 on a QSV worker (tautog); all three calibrated to about the same bitrate (~1.2 Mbps on a 1080p TV clip)",
  "tags": "",
  "flowPlugins": [
    {
      "name": "Input File",
      "sourceRepo": "Community",
      "pluginName": "inputFile",
      "version": "1.0.0",
      "fpEnabled": true,
      "id": "inputFile",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "name": "Skip 4K/HDR",
      "sourceRepo": "Community",
      "pluginName": "customFunction",
      "version": "1.0.0",
      "inputsDB": {
        "code": "// The library tops out at 1080p SDR. A 4K or HDR file is replaced by a fresh\n// 1080p download (media-conformance.py flags it for media-refetch.py), so\n// encoding it is wasted work. Worse, an HEVC 2160p remux takes the audio-only\n// branch, which copies ~60 GB of video into gaming's 40G tmpfs cache and fails\n// every job beside it with ENOSPC (Batman 1989, 11-08).\nconst HDR = ['smpte2084', 'arib-std-b67'];\nmodule.exports = async (args) => {\n  const streams = (args.inputFileObj.ffProbeData || {}).streams || [];\n  const v = streams.find((s) => s.codec_type === 'video' && !(s.disposition || {}).attached_pic) || {};\n  const dv = (v.side_data_list || []).some((d) => d.side_data_type === 'DOVI configuration record');\n  const skip = (v.height || 0) > 1088 || HDR.includes(v.color_transfer) || dv;\n  if (skip) args.jobLog(`skipped: ${v.width}x${v.height} ${v.color_transfer || ''}${dv ? ' DV' : ''}, left for refetch`);\n  return { outputFileObj: args.inputFileObj, outputNumber: skip ? 2 : 1, variables: args.variables };\n};\n"
      },
      "fpEnabled": true,
      "id": "skip4kHdr",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "name": "Set Original (4K/HDR skipped)",
      "sourceRepo": "Community",
      "pluginName": "setOriginalFile",
      "version": "1.0.0",
      "fpEnabled": true,
      "id": "skipped4kHdr",
      "position": {
        "x": 100,
        "y": 250
      }
    },
    {
      "name": "Begin Command",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandStart",
      "version": "1.0.0",
      "fpEnabled": true,
      "id": "beginCmd",
      "position": {
        "x": 200,
        "y": 0
      }
    },
    {
      "name": "Audio Policy",
      "sourceRepo": "Community",
      "pluginName": "customFunction",
      "version": "1.0.0",
      "fpEnabled": true,
      "id": "audioPolicy",
      "position": {
        "x": 400,
        "y": 0
      },
      "inputsDB": {
        "code": {{ lookup('ansible.builtin.file', playbook_dir ~ '/../../../../files/ocean-tdarr/conf/audio-policy.js') | tojson }}
      }
    },
    {
      "name": "Check Video Codec",
      "sourceRepo": "Community",
      "pluginName": "checkVideoCodec",
      "version": "1.0.0",
      "inputsDB": {
        "codecs": "hevc"
      },
      "fpEnabled": true,
      "id": "checkCodec",
      "position": {
        "x": 600,
        "y": 0
      }
    },
    {
      "name": "Route Encoder By Worker",
      "sourceRepo": "Community",
      "pluginName": "customFunction",
      "version": "1.0.0",
      "inputsDB": {
        "code": "// Pick the encoder for the worker running this file. Before this, CPU workers\n// requeued every encode for NVENC, and the requeued files filled tdarr's\n// 100-file staging limit, so harbor sat idle behind ocean's two GPU slots.\n// A GPU worker encodes with whatever its node's gpuSelect names (nvenc on the\n// NVIDIA nodes, qsv on tautog's Iris Xe); anything else runs libx265.\nconst OUTPUTS = { nvenc: 1, qsv: 3 };\nconst ENCODERS = { 1: 'hevc_nvenc', 2: 'libx265', 3: 'hevc_qsv' };\nmodule.exports = async (args) => {\n  const out = (args.workerType === 'transcodegpu' && OUTPUTS[args.nodeHardwareType]) || 2;\n  args.jobLog(`encoder: ${ENCODERS[out]} (worker ${args.workerType}, hardware ${args.nodeHardwareType})`);\n  return { outputFileObj: args.inputFileObj, outputNumber: out, variables: args.variables };\n};\n"
      },
      "fpEnabled": true,
      "id": "routeEncoder",
      "position": {
        "x": 700,
        "y": 100
      }
    },
    {
      "name": "Encode Video Only (CPU)",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandCustomArguments",
      "version": "1.0.0",
      "inputsDB": {
        "outputArguments": "-c:V libx265 -preset:V medium -crf:V 23 -maxrate:V 40M -bufsize:V 50M -x265-params:V log-level=error -disposition:V:0 +default -dn"
      },
      "fpEnabled": true,
      "id": "encodeCpu",
      "position": {
        "x": 800,
        "y": 200
      }
    },
    {
      "name": "Encode Video Only (QSV)",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandCustomArguments",
      "version": "1.0.0",
      "inputsDB": {
        "outputArguments": "-c:V hevc_qsv -preset:V slow -global_quality:V 20 -disposition:V:0 +default -dn"
      },
      "fpEnabled": true,
      "id": "encodeQsv",
      "position": {
        "x": 800,
        "y": 300
      }
    },
    {
      "name": "Encode Video Only",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandCustomArguments",
      "version": "1.0.0",
      "inputsDB": {
        "outputArguments": "-c:V hevc_nvenc -preset:V p7 -rc:V vbr -cq:V 30 -b:V 30M -maxrate:V 40M -bufsize:V 50M -disposition:V:0 +default -dn"
      },
      "fpEnabled": true,
      "id": "encodeAll",
      "position": {
        "x": 800,
        "y": 0
      }
    },
