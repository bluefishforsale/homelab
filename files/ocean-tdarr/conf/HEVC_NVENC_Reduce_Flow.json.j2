{
  "_id": "MinimalHEVC",
  "name": "HEVC NVenc - Minimal Single-Plugin",
  "description": "Audio policy on every file (files/ocean-tdarr/conf/audio-policy.js); HEVC NVENC encode for non-HEVC video, on a GPU worker only (CPU workers take the audio-only passes)",
  "tags": "",
  "flowPlugins": [
    {
      "name": "Input File",
      "sourceRepo": "Community",
      "pluginName": "inputFile",
      "version": "1.0.0",
      "fpEnabled": true,
      "id": "inputFile",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "name": "Begin Command",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandStart",
      "version": "1.0.0",
      "fpEnabled": true,
      "id": "beginCmd",
      "position": {
        "x": 200,
        "y": 0
      }
    },
    {
      "name": "Audio Policy",
      "sourceRepo": "Community",
      "pluginName": "customFunction",
      "version": "1.0.0",
      "fpEnabled": true,
      "id": "audioPolicy",
      "position": {
        "x": 400,
        "y": 0
      },
      "inputsDB": {
        "code": {{ lookup('ansible.builtin.file', playbook_dir ~ '/../../../../files/ocean-tdarr/conf/audio-policy.js') | tojson }}
      }
    },
    {
      "name": "Check Video Codec",
      "sourceRepo": "Community",
      "pluginName": "checkVideoCodec",
      "version": "1.0.0",
      "inputsDB": {
        "codecs": "hevc"
      },
      "fpEnabled": true,
      "id": "checkCodec",
      "position": {
        "x": 600,
        "y": 0
      }
    },
    {
      "name": "Require NVENC Worker",
      "sourceRepo": "Community",
      "pluginName": "tagsWorkerType",
      "version": "1.0.0",
      "inputsDB": {
        "requiredWorkerType": "GPU:nvenc"
      },
      "fpEnabled": true,
      "id": "requireNvenc",
      "position": {
        "x": 700,
        "y": 100
      }
    },
    {
      "name": "Encode Video Only",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandCustomArguments",
      "version": "1.0.0",
      "inputsDB": {
        "outputArguments": "-c:V hevc_nvenc -preset:V p7 -rc:V vbr -cq:V 23 -b:V 30M -maxrate:V 40M -bufsize:V 50M -disposition:V:0 +default -dn"
      },
      "fpEnabled": true,
      "id": "encodeAll",
      "position": {
        "x": 800,
        "y": 0
      }
    },
    {
      "name": "Set Container MKV",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandSetContainer",
      "version": "1.0.0",
      "inputsDB": {
        "container": "mkv",
        "forceConform": "false"
      },
      "fpEnabled": true,
      "id": "setContainer",
      "position": {
        "x": 1000,
        "y": 0
      }
    },
    {
      "name": "Execute",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandExecute",
      "version": "1.0.0",
      "fpEnabled": true,
      "id": "execute",
      "position": {
        "x": 1200,
        "y": 0
      }
    },
    {
      "name": "Compare File Size",
      "sourceRepo": "Community",
      "pluginName": "compareFileSize",
      "version": "1.0.0",
      "fpEnabled": true,
      "id": "compareSize",
      "position": {
        "x": 1400,
        "y": 0
      }
    },
    {
      "name": "Compare Duration",
      "sourceRepo": "Community",
      "pluginName": "compareFileDurationRatio",
      "version": "1.0.0",
      "fpEnabled": true,
      "id": "compareDuration",
      "position": {
        "x": 1600,
        "y": 0
      }
    },
    {
      "name": "Replace Original",
      "sourceRepo": "Community",
      "pluginName": "replaceOriginalFile",
      "version": "1.0.0",
      "fpEnabled": true,
      "id": "replace",
      "position": {
        "x": 1800,
        "y": 0
      }
    },
    {
      "name": "Set Original",
      "sourceRepo": "Community",
      "pluginName": "setOriginalFile",
      "version": "1.0.0",
      "fpEnabled": true,
      "id": "setOriginal",
      "position": {
        "x": 1800,
        "y": 150
      }
    },
    {
      "name": "Set Container MKV (audio only)",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandSetContainer",
      "version": "1.0.0",
      "fpEnabled": true,
      "id": "setContainerAudio",
      "position": {
        "x": 800,
        "y": 300
      },
      "inputsDB": {
        "container": "mkv",
        "forceConform": "false"
      }
    },
    {
      "name": "Execute (audio only)",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandExecute",
      "version": "1.0.0",
      "fpEnabled": true,
      "id": "executeAudio",
      "position": {
        "x": 1000,
        "y": 300
      }
    },
    {
      "name": "Compare Duration (audio only)",
      "sourceRepo": "Community",
      "pluginName": "compareFileDurationRatio",
      "version": "1.0.0",
      "fpEnabled": true,
      "id": "compareDurationAudio",
      "position": {
        "x": 1200,
        "y": 300
      }
    },
    {
      "name": "Set Original (HEVC came out larger)",
      "sourceRepo": "Community",
      "pluginName": "setOriginalFile",
      "version": "1.0.0",
      "fpEnabled": true,
      "id": "resetToOriginal",
      "position": {
        "x": 1600,
        "y": 450
      }
    },
    {
      "name": "Begin Command (keep source video)",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandStart",
      "version": "1.0.0",
      "fpEnabled": true,
      "id": "beginCmdKeepVideo",
      "position": {
        "x": 1400,
        "y": 450
      }
    },
    {
      "name": "Audio Policy (keep source video)",
      "sourceRepo": "Community",
      "pluginName": "customFunction",
      "version": "1.0.0",
      "fpEnabled": true,
      "id": "audioPolicyKeepVideo",
      "position": {
        "x": 1200,
        "y": 450
      },
      "inputsDB": {
        "code": {{ lookup('ansible.builtin.file', playbook_dir ~ '/../../../../files/ocean-tdarr/conf/audio-policy.js') | tojson }}
      }
    }
  ],
  "flowEdges": [
    {
      "source": "inputFile",
      "sourceHandle": "1",
      "target": "beginCmd",
      "targetHandle": null,
      "id": "e1"
    },
    {
      "source": "beginCmd",
      "sourceHandle": "1",
      "target": "audioPolicy",
      "targetHandle": null,
      "id": "e2"
    },
    {
      "source": "audioPolicy",
