# photonic_inventory - environment file
# Rendered from files/photonic_inventory/photonic_inventory.env.j2 with values
# from vault/secrets.yaml. Vault keys live under the top-level
# `photonic_inventory:` group.

DB_PATH=/data/photonic.db

# Bind inside the container; nginx + cloudflared terminate TLS in front.
BIND_HOST=0.0.0.0
BIND_PORT={{ port_int }}
COOKIE_SECURE={{ photonic_inventory.cookie_secure | default('true') }}

# argon2 hashes and signing secrets can contain `$`, which docker-compose v2
# interpolates in unquoted env_file values. Single-quote so compose passes
# them through literally.
SESSION_SECRET='{{ photonic_inventory.session_secret | default("UNSET") }}'
ARGON2_PEPPER='{{ photonic_inventory.argon2_pepper | default("UNSET") }}'

# Seeded on first boot only, if the admin row does not yet exist.
BOOTSTRAP_ADMIN_EMAIL={{ photonic_inventory.bootstrap_admin_email | default('admin@terrac.com') }}

# Outbound email (invites, weekly digest). With photonic_inventory.resend_api_key
# in the vault it goes through Resend's SMTP relay as gear@radiantatmospheres.com,
# a domain Resend already has verified for the RA contact form; without it, Gmail
# SMTP with the app password. When SMTP_PASSWORD is unset the app falls back to
# showing the invite link to the admin instead of sending it. Secrets and the
# display-name From are single-quoted in case they contain characters compose
# would interpolate; Gmail app password spaces are stripped (Gmail rejects the
# spaced display form).
{% if photonic_inventory.resend_api_key | default('') %}
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=resend
SMTP_FROM='{{ photonic_inventory.smtp_from | default('Photonic Inventory <gear@radiantatmospheres.com>') }}'
SMTP_PASSWORD='{{ photonic_inventory.resend_api_key }}'
{% else %}
SMTP_HOST={{ photonic_inventory.smtp_host | default('smtp.gmail.com') }}
SMTP_PORT={{ photonic_inventory.smtp_port | default('587') }}
SMTP_STARTTLS={{ photonic_inventory.smtp_starttls | default('true') }}
SMTP_USER={{ photonic_inventory.smtp_user | default(photonic_inventory.bootstrap_admin_email | default('')) }}
SMTP_FROM={{ photonic_inventory.smtp_from | default(photonic_inventory.smtp_user | default(photonic_inventory.bootstrap_admin_email | default(''))) }}
SMTP_PASSWORD='{{ photonic_inventory.gmail_app_password | default("") | replace(" ", "") }}'
{% endif %}
PUBLIC_BASE_URL={{ photonic_inventory.public_base_url | default('https://gear.radiantatmospheres.com') }}

# Bearer key for the app's /api/admin/* (scripts/pi_admin.py in the app repo).
# Rendered only when vaulted: the app refuses an empty or short key at boot,
# and without the line the API answers 404.
{% if photonic_inventory.admin_api_key | default('') %}
ADMIN_API_KEY='{{ photonic_inventory.admin_api_key }}'
{% endif %}

# Google sign-in. Link-only: the verified Google email must match an existing,
# active person — no accounts are auto-created. The button hides and the routes
# 404 while these are unset, so an empty default is a safe off switch.
# Single-quoted because a client secret can contain characters docker-compose
# would otherwise interpolate.
GOOGLE_CLIENT_ID='{{ photonic_inventory.google_oauth.id | default("") }}'
GOOGLE_CLIENT_SECRET='{{ photonic_inventory.google_oauth.secret | default("") }}'
