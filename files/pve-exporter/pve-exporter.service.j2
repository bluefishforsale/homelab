[Unit]
Description=Proxmox VE Exporter
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
# Compose project so the refresh timer sees it; crash recovery is the container's
# own `restart: unless-stopped`, since Restart= is not valid on a oneshot.
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ compose_dir }}
StandardOutput=journal
StandardError=journal
ExecStart=/usr/bin/docker compose -f {{ compose_dir }}/docker-compose.yml up -d
ExecStop=/usr/bin/docker compose -f {{ compose_dir }}/docker-compose.yml down --timeout 30
TimeoutStartSec=300
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
