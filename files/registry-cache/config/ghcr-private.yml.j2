version: 0.1
log:
  level: info
  fields:
    service: registry
    upstream: ghcr-private
proxy:
  remoteurl: https://ghcr.io
  username: "{{ development.github.github_owner }}"
  password: "{{ development.github.packages_read_token }}"
auth:
  htpasswd:
    realm: basic-realm
    path: /auth/htpasswd
storage:
  filesystem:
    rootdirectory: /var/lib/registry
  maintenance:
    uploadpurging:
      enabled: true
      age: 168h
      interval: 24h
      dryrun: false
  delete:
    enabled: true
http:
  addr: :5000
  headers:
    X-Content-Type-Options: [nosniff]
  debug:
    addr: :5001
    prometheus:
      enabled: true
      path: /metrics
health:
  storagedriver:
    enabled: true
    interval: 30s
    threshold: 3
