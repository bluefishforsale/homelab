# Rendered by playbooks/individual/ocean/services/spend_tracker.yaml (mode 0600).
# One file for both containers: Postgres reads POSTGRES_*, the collector reads
# the libpq PG* names, so the password is never spliced into a connection URL.
POSTGRES_USER=spend
POSTGRES_PASSWORD={{ spend_tracker.postgres_password }}
POSTGRES_DB=spend
PGHOST=postgres
PGUSER=spend
PGPASSWORD={{ spend_tracker.postgres_password }}
PGDATABASE=spend
# Monarch browser session cookies, base64 of a JSON object. Read-only use, but
# the cookie itself is a full login to the account. It expires on Monarch's
# schedule; refresh it with `uv run monarch-mcp login --cookies` on the laptop
# and rotate this key.
MONARCH_COOKIES_B64={{ spend_tracker.monarch_cookies_b64 }}
SPEND_LOOKBACK_DAYS={{ spend_lookback_days }}
SPEND_SYNC_SECONDS={{ spend_sync_seconds }}
SPEND_PORT={{ spend_internal_port }}
