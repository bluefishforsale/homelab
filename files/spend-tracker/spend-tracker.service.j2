[Unit]
Description={{ service }}
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
# Started without the state disk, compose would bind an empty mountpoint and
# Postgres would init a fresh, empty cluster on the OS disk.
RequiresMountsFor=/data01/services

[Service]
# Compose project rather than a bare `docker run`, so `docker compose ls` sees
# it and the weekly docker-refresh@ instance covers it. Crash recovery is the
# containers' own `restart: unless-stopped`, because Restart= is not valid on a
# oneshot.
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ home }}
StandardOutput=journal
StandardError=journal
ExecStartPre=-/usr/bin/docker compose down --timeout 30
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down --timeout 30
TimeoutStartSec=300
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
