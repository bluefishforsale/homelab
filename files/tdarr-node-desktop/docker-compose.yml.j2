# Rendered by playbooks/individual/workers/tdarr_node_desktop.yaml.
#
# A tdarr node on a desktop that someone also uses: the iGPU encodes through
# /dev/dri (gpuSelect {{ node.gpu_select }}, the flow's hevc_qsv branch), the
# library comes over NFS from ocean, and the cache is on the local disk.
#
# NOTE: the image tag follows the server's version. A node refuses a server of
# another version; tdarr-node-version-sync repins this tag when the server moves.
services:
  tdarr-node:
    image: "ghcr.io/haveagitgat/tdarr_node:{{ tdarr_node_version }}"
    container_name: tdarr-node
    hostname: "tdarr-node-{{ name }}"
    environment:
      TZ: America/Los_Angeles
      PUID: "{{ system_users.media.uid }}"
      PGID: "{{ system_users.media.gid }}"
      inContainer: "true"
      serverIP: "{{ tdarr_server_ip }}"
      serverPort: "{{ tdarr_server_api_port }}"
      nodeName: "{{ name }}.home"
      nodeIP: "{{ node.ip }}"
      nodePort: "8267"
    devices:
      - /dev/dri:/dev/dri
    group_add:
      - "{{ node.render_gid }}"
      - "{{ node.video_gid }}"
    volumes:
      - /usr/share/zoneinfo:/usr/share/zoneinfo:ro
      # Same in-container paths as every other node, so no path translation.
      - /data01/complete:/media
      - "{{ home }}/cache:/temp"
      - "{{ home }}/configs:/app/configs"
      - "{{ home }}/logs:/app/logs"
    ports:
      - "8267:8267"
    healthcheck:
      test: ["CMD-SHELL", "grep -qas Tdarr_Node /proc/[0-9]*/cmdline"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 60s
    # Started and stopped by tdarr-node.service only (mains power, not asleep).
    restart: "no"
